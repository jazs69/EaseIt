NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://easeit:easeit@localhost:5432/easeit?schema=public"
DIRECT_URL="postgresql://easeit:easeit@localhost:5432/easeit?schema=public"
REDIS_URL="redis://localhost:6379"

# Signs session tokens. A labelled derivation of this also peppers the stored
# one-time-password hashes, so rotating it invalidates both at once and logs
# everybody out. At least 32 characters of real entropy:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-at-least-32-characters-of-random-entropy"
JWT_EXPIRES_IN="8h"

API_CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Session cookie
# ---------------------------------------------------------------------------
AUTH_COOKIE_NAME="easeit_session"
# Leave unset in development: `localhost` is host-only and cookies ignore the
# port, so the API on :4000 and the admin app on :3001 already share one. In
# production set the registrable domain (".yourdomain.com") so the cookie the
# API sets is readable by pms.yourdomain.com.
# AUTH_COOKIE_DOMAIN=".yourdomain.com"
# Unset means "Secure in production, not in development". Cannot be disabled in
# production — the API refuses to boot.
# AUTH_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Outbound mail — delivers the two-factor codes
# ---------------------------------------------------------------------------
# Leave SMTP_HOST unset in development and codes are printed to the API's own
# console instead of being emailed, so the flow is testable without
# credentials. The code never goes to the browser either way.
#
# SMTP_HOST is REQUIRED in production: validateEnv refuses to start without it,
# because with no transport nobody could ever receive a code and every sign-in
# would fail.
#
# Gmail needs an App Password (not the account password) with 2-step
# verification enabled: https://myaccount.google.com/apppasswords
# It may be pasted with or without the spaces Google displays it in.
#
# SMTP_USER and SMTP_PASS must be set together — the API refuses to boot with
# only one of them, because a half-configured relay authenticates as nobody and
# fails on the first send.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false          # true only for implicit TLS on port 465
# SMTP_USER="you@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM='"EaseIt Security" <you@gmail.com>'
# SMTP_REPLY_TO="support@yourdomain.com"

# --- GSTIN verification ------------------------------------------------------
# 'mock' returns clearly-marked synthetic taxpayer data so the booking form
# works without paid credits. Refused in production: a fabricated legal name
# would reach a real tax invoice.
GST_PROVIDER="mock"
GST_API_KEY=""
GST_API_SECRET=""
GST_TIMEOUT_MS="4000"
