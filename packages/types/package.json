{
  "name": "@repo/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared DTOs, domain contracts and RBAC definitions for EaseIt",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rbac": {
      "types": "./dist/rbac.d.ts",
      "default": "./dist/rbac.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "eslint": "9.39.5",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
