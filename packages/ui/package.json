{
  "name": "@repo/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Tailwind/shadcn-ui React component library for the EaseIt web apps",
  "exports": {
    ".": "./src/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/types": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3"
  }
}
