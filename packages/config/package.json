{
  "name": "@repo/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript, ESLint, Prettier and Tailwind configuration for the EaseIt monorepo",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./eslint/base": "./eslint/base.js",
    "./eslint/nestjs": "./eslint/nestjs.js",
    "./eslint/next": "./eslint/next.js",
    "./eslint/react-library": "./eslint/react-library.js",
    "./prettier": "./prettier/index.mjs",
    "./tailwind/preset.css": "./tailwind/preset.css"
  },
  "files": [
    "tsconfig.base.json",
    "tsconfig",
    "eslint",
    "prettier",
    "tailwind"
  ],
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint-config-next": "16.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-turbo": "2.11.8",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.2"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  },
  "scripts": {
    "lint": "echo \"@repo/config holds config assets only — nothing to lint\"",
    "clean": "rm -rf .turbo"
  }
}
