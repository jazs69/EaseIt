// =============================================================================
// EaseIt — multi-tenant Hotel PMS schema
// -----------------------------------------------------------------------------
// Tenancy model (CLAUDE.md section 3.2): one PostgreSQL database, row-level
// isolation keyed on `propertyId`. Three kinds of table exist here:
//
//   * Tenant root       — `Property`.
//   * Tenant-scoped     — carries `propertyId`, every composite index leads
//                         with it: `UserPropertyRole`, and custom `Role` rows.
//   * Portfolio catalog — shared by all 10 hotels, no `propertyId`:
//                         `Permission`, and system `Role` templates.
//   * Identity          — attached to `User`, not to a property, and therefore
//                         also without `propertyId`: `TwoFactorChallenge`.
//
// `User` is portfolio-wide identity: one person, one credential, even when
// they work at three hotels. Authority is never implied by the user row — it
// comes only from `UserPropertyRole`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// Prisma 7 removed `url` / `directUrl` from the schema: connection strings for
// Migrate now live in prisma.config.ts, and the runtime connection comes from
// the driver adapter passed to the PrismaClient constructor (see src/index.ts).
datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Mirrors `Role` in @repo/types/rbac. Set on system role templates only;
/// custom roles have a null `key`. The seed asserts the two stay in lockstep.
enum RoleKey {
  SUPER_ADMIN
  PROPERTY_ADMIN
  FRONT_DESK
  HOUSEKEEPING
  REVENUE_MANAGER
  NIGHT_AUDITOR
  POS_STAFF
}

/// Mirrors `PropertyStatus` in @repo/types/domain. Replaces the former
/// `isActive` boolean: a property that is being onboarded is neither live nor
/// retired, and a boolean cannot say so (CLAUDE.md section 3.4 — status is a
/// state machine, not a free-form string, and not a flag either).
enum PropertyStatus {
  /// Trading. The only status the booking engine will sell.
  ACTIVE
  /// Being configured. Staff may sign in; it is not sellable.
  ONBOARDING
  /// Retired. Read-only for reporting and audit history.
  INACTIVE
}

/// Mirrors `ReservationStatus` in @repo/types/domain. The legal transitions
/// between these live in one place in the domain layer, never in a controller
/// or a bare Prisma update (CLAUDE.md section 3.4).
enum ReservationStatus {
  /// Held, not confirmed. Expires, and does NOT consume inventory.
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  /// Awaiting payment or a decision. Holds a room but is not yet a sale, so
  /// like TENTATIVE it does not consume inventory.
  ON_HOLD
}

/// Board basis. An enum rather than a free-form string: these four are the
/// whole set, and a typo in a string column silently becomes a rate the
/// pricing code cannot interpret (CLAUDE.md section 3.4).
enum MealPlan {
  /// European — room only.
  EP
  /// Continental — breakfast.
  CP
  /// Modified American — breakfast and one meal.
  MAP
  /// American — all meals.
  AP
}

enum PaymentGatewayProvider {
  RAZORPAY
  STRIPE
}

enum PaymentGatewayStatus {
  /// Onboarding started, identity checks outstanding. Cannot take payments.
  PENDING_KYC
  ACTIVE
  INACTIVE
}

/// Mirrors `RoomStatus` in @repo/types/domain.
enum RoomStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED_CLEAN
  OCCUPIED_DIRTY
  INSPECTED
  /// Temporarily unsellable (maintenance). Still counted as physical stock.
  OUT_OF_SERVICE
  /// Unsellable and NOT counted as physical stock.
  OUT_OF_ORDER
}

/// Where a photograph was taken.
enum MediaCategory {
  EXTERIOR
  INTERIOR
  RECEPTION
  ROOM_BEDROOM
  ROOM_WASHROOM
  AMENITY_BANQUET
  AMENITY_POOL
  AMENITY_GARDEN
  PARKING
  RESTAURANT
  OTHERS
}

/// Whether an amenity is included or charged for.
enum AmenityScope {
  FREE
  PAID
}

/// The kind of policy a property publishes.
enum PolicyType {
  CANCELLATION
  AMENDMENT
  CHECK_IN_CHECK_OUT
  HOUSE_RULES
  TERMS_AND_CONDITIONS
  CUSTOM
}

/// How a fee is computed.
enum FeeType {
  PERCENTAGE
  FIXED_PER_NIGHT
  FIXED_PER_STAY
  FIXED_PER_GUEST
}

/// What a folio line represents.
///
/// One table with a discriminator rather than separate charge and payment
/// tables. CLAUDE.md section 3.4 requires a folio balance to be derived by
/// summing its lines; across two tables that sum spans two queries, two
/// reversal paths and two chances to disagree. One ledger, signed amounts,
/// one sum.
enum FolioLineKind {
  /// Nightly room tariff for one business date.
  ROOM_CHARGE
  /// Tax derived from a specific charge, carrying `derivedFromLineId`.
  TAX
  /// Food, laundry, minibar — anything posted by an outlet.
  SERVICE_CHARGE
  /// Money received. Stored negative, so the balance is a plain sum.
  PAYMENT
  /// Money returned. Stored positive.
  REFUND
  /// A manual correction, always paired with `reversesLineId`.
  ADJUSTMENT
}

enum FolioStatus {
  /// Accepting postings. Exactly one open folio per reservation.
  OPEN
  /// Settled and closed by the night audit or at check-out.
  CLOSED
  /// Moved to another folio, e.g. a group master.
  TRANSFERRED
}

/// Where a company's legal name came from.
///
/// Recorded permanently, because the three are not interchangeable on a tax
/// invoice. MOCK exists so synthetic development data stays identifiable after
/// it is saved — without it, a company created against the mock provider is
/// indistinguishable from a verified one the moment the request ends, which is
/// precisely the confusion that makes a fake legal name dangerous.
enum GstinVerification {
  /// Structure and check digit only. The operator typed the name.
  UNVERIFIED
  /// Synthetic data from the development provider. Never trust on an invoice.
  MOCK
  /// Confirmed against the GST registry by a live provider.
  VERIFIED
}

/// How a payment was taken at the desk.
enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

/// The kind of government photo ID recorded at check-in.
///
/// An enum, not a free string: the set is fixed by what Indian hotels may
/// legally accept, and a typo'd "passprt" would silently create a category
/// nobody can report on (CLAUDE.md section 5).
enum GovtIdType {
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  PAN
}

/// Mirrors `BookingSource` in @repo/types/domain.
///
/// Two granularities live in one field, deliberately. The original members are
/// a source *type* (how the booking arrived); the named OTAs below are a
/// channel *identity*. Keeping them in one enum is what lets a reservation say
/// "Agoda" rather than the useless "OTA", which is what the booking-source
/// report needs — and it stays additive, so no existing row changes meaning.
///
/// When the `channels` module lands it owns channel identity properly (a
/// mapping row per property per channel, per CLAUDE.md section 2) and these
/// named members become a foreign key. Until then this is the only place a
/// booking can record which OTA sold it.
///
/// Note there is no `DIRECT_WEBSITE`: that is `DIRECT_WEB`, already here. Two
/// members meaning one thing is exactly the near-synonym trap section 6.1
/// warns about — the report labels it "DIRECT WEBSITE" at the presentation
/// layer instead.
enum BookingSource {
  DIRECT_WEB
  FRONT_DESK
  PHONE
  WALK_IN
  OTA
  CORPORATE
  TRAVEL_AGENT

  /// Named OTAs. `OTA` remains for a channel with no member of its own.
  MAKEMYTRIP
  AGODA
  BOOKING_COM
  EXPEDIA
  CLEARTRIP
}

/// Mirrors `PermissionCategory` in @repo/types/rbac. Drives the grouping of
/// the permission matrix in the admin role editor.
enum PermissionCategory {
  FRONT_DESK
  HOUSEKEEPING
  BILLING
  RATES_DISTRIBUTION
  NIGHT_AUDIT
  ADMINISTRATION
}

// -----------------------------------------------------------------------------
// Property — the tenant root
// -----------------------------------------------------------------------------

model Property {
  id   String @id @default(uuid()) @db.Uuid
  /// URL-safe tenant key. Resolved server-side by the booking engine; never
  /// trusted from a client header (CLAUDE.md section 3.2).
  slug String @unique
  /// Short operator-facing identifier, e.g. "31336". What staff say on the
  /// phone and what appears on printed folios; distinct from `slug`, which is
  /// a URL segment, and from `id`, which is never shown to anybody.
  code String @unique
  name String

  legalName String?

  /// Optional brand mark for the group dashboard. Null falls back to initials
  /// rendered client-side, so a missing logo is never a broken image.
  logoUrl String?

  /// Operating region this property reports under, e.g. "Bhopal Division".
  /// Free text: divisions are an org-chart concern that changes without a
  /// migration, and nothing in the domain branches on it.
  division String?

  /// IANA zone, e.g. "Asia/Kolkata". Drives this property's night-audit
  /// schedule — ten properties means ten independent schedules.
  timezone String @default("Asia/Kolkata")
  /// ISO-4217. Every monetary amount stored against this property is an
  /// integer count of this currency's minor unit (CLAUDE.md section 3.4).
  currency String @default("INR") @db.Char(3)
  locale   String @default("en-IN")

  /// The property's open accounting day. A calendar date, NOT a timestamp,
  /// advanced only by the night audit's business-date-roll step.
  businessDate DateTime @db.Date

  /// Local wall-clock times, "HH:MM".
  /// Flat GST percentage applied to room tariff, or null for statutory slabs.
  ///
  /// ===========================================================================
  /// A `Decimal`, which section 3.4 permits for tax *rates* — it bans Decimal
  /// for money, not for percentages.
  ///
  /// Null means the statutory room-tariff treatment: 12% below ₹7,500 a night
  /// and 18% at or above it. A value overrides that with a flat rate for every
  /// tariff.
  ///
  /// This exists because the rate is a per-property configuration, not a
  /// constant — section 3.4 already requires inclusive-vs-exclusive tax to be
  /// a property setting, and the rate belongs with it. Hard-coding one number
  /// means a rate change ships as a deployment, and a wrong one cannot be
  /// corrected at all.
  /// ===========================================================================
  taxRatePercent Decimal? @db.Decimal(5, 2)

  checkInTime  String @default("14:00")
  checkOutTime String @default("11:00")

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  countryCode  String  @default("IN") @db.Char(2)
  phone        String?
  email        String?

  /// Supersedes the former `isActive` boolean. One column, one truth: a
  /// property cannot be simultaneously active and onboarding.
  status PropertyStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Roles this property has defined for itself (isCustom = true).
  customRoles Role[]
  staffRoles  UserPropertyRole[]

  roomTypes      RoomType[]
  rooms          Room[]
  inventoryDays  InventoryDay[]
  reservations   Reservation[]
  gatewayConfigs PaymentGatewayConfig[]
  companies      Company[]
  folios         Folio[]
  auditLogs      AuditLog[]
  outboxEvents   OutboxEvent[]
  settings       PropertySettings?
  taxSlabs       PropertyTaxSlab[]
  media          PropertyMedia[]
  amenityLinks   PropertyAmenityLink[]
  policies       PropertyPolicy[]
  fees           FeeAndSurcharge[]

  @@index([status])
  @@map("property")
}

// -----------------------------------------------------------------------------
// User — portfolio-wide identity
// -----------------------------------------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Globally unique across the portfolio. Deliberately not scoped by
  /// property: one human holds one credential and is granted access per
  /// property through UserPropertyRole.
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime? @db.Timestamptz(6)

  /// Whether sign-in requires the emailed second factor.
  ///
  /// Defaults to **true**, and that direction matters: a new account is
  /// protected unless somebody deliberately weakens it, rather than exposed
  /// until somebody remembers to protect it. A PMS login opens folios, refunds
  /// and rate overrides, so the safe default is the strict one.
  ///
  /// Setting this false is a real reduction in security and is honoured only
  /// because some integration accounts cannot receive mail. The login path
  /// answers `authenticated` instead of `two_factor_required` for those, which
  /// the `loginResultSchema` discriminated union already models.
  isTwoFactorEnabled Boolean @default(true)

  /// Sessions issued before this instant are refused.
  ///
  /// How signing out actually ends a session. The session token is a stateless
  /// JWT, so clearing the cookie stops *this* browser sending it but cannot
  /// stop a copy of it being replayed until it expires — up to eight hours.
  /// Signing out stamps this, and the guard refuses any token whose `iat` is
  /// older, which revokes every session that user holds.
  ///
  /// One nullable column rather than a session table or a Redis denylist: the
  /// guard already loads this row on every request to check `isActive`, so the
  /// check costs one more selected column and no extra query. A denylist would
  /// add a datastore to maintain and expire for the same effect (CLAUDE.md
  /// section 6.4).
  sessionsValidFrom DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  propertyRoles       UserPropertyRole[]
  twoFactorChallenges TwoFactorChallenge[]

  @@index([isActive])
  @@map("user")
}

// -----------------------------------------------------------------------------
// TwoFactorChallenge — the outstanding second factor
// -----------------------------------------------------------------------------

/// One email-OTP challenge: created when a password check succeeds, consumed
/// when the matching code arrives, and useless afterwards.
///
/// Not tenant-scoped. It hangs off portfolio-wide `User` identity exactly as
/// the credential itself does, so it carries no `propertyId` and is listed in
/// `PORTFOLIO_GLOBAL_MODELS` (CLAUDE.md section 3.2). `requestedPropertyId` is
/// a *preference* carried through from the login request — step 2 re-verifies
/// the grant before honouring it, so it never confers access.
///
/// The code itself is never stored. `codeHash` is an HMAC-SHA256 of the digits
/// under a server-side pepper, so a database dump alone cannot be turned back
/// into a working code: a six-digit space is small enough that an unkeyed
/// digest of it is equivalent to plaintext.
model TwoFactorChallenge {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The address the code was sent to, snapshotted at issue time. If the
  /// account's email changes mid-challenge, the audit trail still records
  /// where the code actually went.
  email String

  /// HMAC-SHA256(code, pepper), lowercase hex. Never the code.
  codeHash String

  /// When the *current* code stops working. A resend replaces both.
  expiresAt DateTime @db.Timestamptz(6)
  /// Start of the resend cooldown for the current code.
  lastSentAt DateTime @db.Timestamptz(6)

  /// Wrong codes so far. At TWO_FACTOR.MAX_ATTEMPTS the challenge is burned.
  attempts    Int @default(0)
  /// Codes re-issued so far, capped at TWO_FACTOR.MAX_RESENDS.
  resendCount Int @default(0)

  /// Set exactly once, by the verification that succeeded. The write is
  /// guarded on this still being null, which is what makes a single code
  /// single-use even if two requests race.
  consumedAt DateTime? @db.Timestamptz(6)
  /// Set when the challenge is abandoned: attempts exhausted, or superseded by
  /// a newer sign-in attempt from the same account.
  revokedAt  DateTime? @db.Timestamptz(6)

  /// The property the operator asked to work in, if they named one. A request,
  /// never an assertion — re-checked against UserPropertyRole at step 2.
  requestedPropertyId String? @db.Uuid

  /// Forensics for a suspicious sign-in. Deliberately not the full header set:
  /// no PII beyond what a login already implies (CLAUDE.md section 5).
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Finding a user's live challenges, newest first.
  @@index([userId, createdAt])
  /// Sweeping expired rows.
  @@index([expiresAt])
  @@map("two_factor_challenge")
}

// -----------------------------------------------------------------------------
// Role — system template (propertyId null) or property-custom
// -----------------------------------------------------------------------------

/// A named bundle of permissions.
///
/// `propertyId == null` is a **system template**, shared read-only by the
/// whole portfolio and seeded from DEFAULT_ROLE_PERMISSIONS. `propertyId` set
/// is a **custom role** owned by that property — for example a combined
/// "Front Desk & Night Auditor" for a small hotel where one person covers
/// both. Custom roles are the only ones an administrator may edit or delete.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String  @default("")
  isCustom    Boolean @default(false)

  /// Set on system templates, null on custom roles. Lets the application map
  /// a row back to the typed `Role` union in @repo/types.
  key RoleKey?

  /// Null for a system template; set for a role owned by one property.
  propertyId String?   @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  permissions RolePermission[]
  assignments UserPropertyRole[]

  // A property cannot have two roles with the same name. System templates are
  // covered by a partial unique index on `key` added in the migration, since
  // PostgreSQL treats NULL propertyIds as distinct and this constraint would
  // not catch duplicates among them.
  @@unique([propertyId, name], name: "role_unique_name_per_property")
  @@index([propertyId])
  @@index([isCustom])
  @@map("role")
}

// -----------------------------------------------------------------------------
// Permission — portfolio catalog
// -----------------------------------------------------------------------------

/// The authoritative list of grantable actions, seeded from
/// PERMISSION_DEFINITIONS in @repo/types.
///
/// Modelled as a table rather than a bare string column on RolePermission so
/// that a typo cannot become a silently unenforceable grant: the foreign key
/// rejects any key that is not in the catalog.
model Permission {
  id String @id @default(uuid()) @db.Uuid

  /// `module:action`, e.g. "reservations:checkin". A wire contract shared with
  /// @repo/types: additive only, never renamed.
  key         String             @unique
  label       String
  description String
  category    PermissionCategory
  /// True when granting this lets the holder move money or reduce revenue.
  sensitive   Boolean            @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@index([category])
  @@map("permission")
}

/// Join between a role and the permissions it grants.
model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// -----------------------------------------------------------------------------
// UserPropertyRole — the tenant-scoped grant
// -----------------------------------------------------------------------------

/// The row that actually confers access: this user holds this role at this
/// property.
///
/// Multiple rows per (user, property) are expected and supported — a clerk at
/// a small hotel may hold both Front Desk and Night Auditor, and their
/// effective permissions are the union of the two. The same user may equally
/// hold different roles at different properties.
model UserPropertyRole {
  id String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid
  propertyId String @db.Uuid
  roleId     String @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Audit trail: who granted this and when (CLAUDE.md section 3.4).
  grantedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([userId, propertyId, roleId], name: "user_property_role_unique")
  // Tenant-scoped reads lead with propertyId, per CLAUDE.md section 3.2.
  @@index([propertyId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("user_property_role")
}

// =============================================================================
// Inventory and reservations
// -----------------------------------------------------------------------------
// This is the part of the schema CLAUDE.md section 3.1 governs, and the only
// part where the *database* rather than the application is the guarantee. Two
// constraints carry that weight, neither is expressible in Prisma, so both live
// in hand-written SQL in the migration and must never be dropped:
//
//   1. inventory_day_not_oversold
//        CHECK (sold + blocked <= physical + overbookingAllowance)
//      Selling a room is an UPDATE that increments `sold` on each stay date. A
//      losing concurrent booking fails this and its transaction rolls back,
//      which is correct under any isolation level.
//
//   2. reservation_room_no_overlap
//        EXCLUDE USING gist (roomId WITH =, daterange(...) WITH &&)
//        WHERE (status NOT IN ('CANCELLED','NO_SHOW'))
//      The same physical room can never hold two overlapping stays.
//
// Departure day is exclusive, so every range is half-open: a room checked out
// in the morning is sellable that same night.
// =============================================================================

/// A sellable category of room, e.g. "Deluxe Suite".
///
/// Availability is counted per room *type* per date (see InventoryDay), not per
/// physical room: guests book a category, and the front desk assigns a number
/// later — often not until check-in.
model RoomType {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Short operator-facing code, e.g. "DLX". Unique within the property.
  code        String
  name        String
  description String?

  maxGuests Int
  maxAdults Int?

  /// Rack rate in the currency's **minor unit** — paise for INR, so 3500 INR
  /// is 350000 (CLAUDE.md section 3.4). Never a float, never a major-unit
  /// decimal. Paired with `currency`, so an amount is never ambiguous.
  baseRateMinor Int
  currency      String @db.Char(3)

  /// Default allowance copied onto new InventoryDay rows. Overbooking is only
  /// ever deliberate; it is never a side effect of a race (section 3.1).
  overbookingAllowance Int @default(0)

  sortOrder Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  rooms            Room[]
  inventoryDays    InventoryDay[]
  reservationRooms ReservationRoom[]
  media            PropertyMedia[]

  @@unique([propertyId, code], name: "room_type_unique_code_per_property")
  @@unique([propertyId, name], name: "room_type_unique_name_per_property")
  @@index([propertyId, sortOrder])
  @@map("room_type")
}

/// A physical, numbered room.
model Room {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  /// "101". Unique within the property, not globally.
  number String
  floor  String?

  /// Housekeeping state. OUT_OF_ORDER rooms drop out of physical stock when
  /// inventory is rebuilt; OUT_OF_SERVICE rooms stay counted.
  status RoomStatus @default(VACANT_CLEAN)

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  reservationRooms ReservationRoom[]

  @@unique([propertyId, number], name: "room_unique_number_per_property")
  @@index([propertyId, roomTypeId])
  @@index([propertyId, status])
  @@map("room")
}

/// One row per (property, room type, stay date): the availability counter.
///
/// This table *is* the oversell guarantee. The CHECK added in the migration
/// physically cannot hold a row where more rooms are sold and blocked than
/// exist, so two concurrent bookings for the last room cannot both commit —
/// one fails the constraint and rolls back entirely.
model InventoryDay {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  /// A calendar date, never an instant. Built from the property's own timezone,
  /// never from a client's local time (CLAUDE.md section 3.3).
  stayDate DateTime @db.Date

  /// Sellable rooms of this type on this date, excluding OUT_OF_ORDER.
  physical Int
  /// Rooms consumed by non-cancelled reservations.
  sold     Int @default(0)
  /// Rooms withheld from sale: maintenance, owner use, group holds.
  blocked  Int @default(0)

  /// Deliberate oversell headroom, set by a Revenue Manager.
  overbookingAllowance Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, roomTypeId, stayDate], name: "inventory_day_unique_per_date")
  @@index([propertyId, stayDate])
  @@map("inventory_day")
}

/// A booking.
///
/// Guest details are embedded rather than pointing at a `Guest` profile table,
/// which does not exist yet. That is a known provisional shape: the `frontdesk`
/// module in CLAUDE.md section 2 owns guest profiles, and these columns become
/// a foreign key when it lands. They are kept minimal so that migration stays
/// additive — and none of them is ever logged, because guest PII must not reach
/// a log line (section 5).
model Reservation {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// What the guest quotes on the phone. Unique per property, not globally — a
  /// unique constraint omitting propertyId would couple unrelated hotels
  /// (CLAUDE.md section 3.2).
  confirmationCode String

  status ReservationStatus @default(CONFIRMED)
  source BookingSource     @default(FRONT_DESK)

  /// Half-open: arrival inclusive, departure exclusive.
  arrivalDate   DateTime @db.Date
  departureDate DateTime @db.Date

  adults   Int @default(1)
  children Int @default(0)
  /// Under 2s. Counted separately because they do not consume occupancy for
  /// rate or capacity purposes, so folding them into `children` would inflate
  /// both the occupancy figure and the price.
  infants  Int @default(0)

  guestFirstName String
  guestLastName  String
  guestEmail     String?
  guestPhone     String?

  /// The channel's own reservation id, for an OTA booking.
  ///
  /// Required by the inbound sync contract, not just by search: CLAUDE.md
  /// section 5 makes ingestion idempotent *on the channel's reservation id*,
  /// and that is impossible without storing it. The unique index below is what
  /// actually enforces it — an index alone would let a retried webhook create
  /// a second copy of the same booking. Null for anything sold directly.
  otaBookingId String?

  /// Government photo ID, where one was recorded at check-in.
  ///
  /// ===========================================================================
  /// Guest PII of the most sensitive kind — Aadhaar, passport, PAN, licence.
  /// Indian hotels are legally required to record it, so the column has to
  /// exist, and the front desk searches by its last digits when a guest
  /// presents a card. That forces a plaintext column: a one-way hash cannot
  /// answer a partial match.
  ///
  /// Two rules therefore apply wherever it is touched, both enforced in the
  /// API rather than here:
  ///   * It is NEVER returned whole. The search response carries a masked form
  ///     (`XXXX-XXXX-1234`) plus the last four, never the full value.
  ///   * It is NEVER logged, not in a query log, not in an error context, and
  ///     not in a channel payload dump (CLAUDE.md section 5).
  ///
  /// When a `guests` module lands with real guest profiles this moves there,
  /// with column-level encryption and an access audit trail.
  /// ===========================================================================
  govtIdNumber String?

  /// Which document `govtIdNumber` is. Null when no ID was recorded.
  govtIdType GovtIdType?

  mealPlan MealPlan @default(EP)

  /// Integer minor units, paired with its currency (section 3.4). The folio is
  /// the authority on what is actually owed; this is the agreed stay total.
  totalAmountMinor Int
  currency         String @db.Char(3)

  /// Settled so far, in minor units.
  ///
  /// Provisional, and knowingly against the grain of section 3.4: a balance
  /// must be *derived* by summing immutable folio lines, never cached. There
  /// is no Folio table yet, so this is the minimum that lets the front desk
  /// see what is outstanding. Note what is deliberately NOT here: a
  /// `balanceAmount` column. The balance is computed as
  /// `totalAmountMinor - paidAmountMinor` at the API boundary, so there is no
  /// third number able to disagree with the two it comes from. When `folios`
  /// lands, both of these become derived and this column is dropped.
  paidAmountMinor Int @default(0)

  /// Who checked the guest in, and with what.
  ///
  /// `checkedInAt` already existed for the hourly calendar view; these record
  /// the rest of the desk transaction. `checkedInBy` is a staff user id rather
  /// than a name, so a renamed account does not rewrite history.
  checkedInBy            String?  @db.Uuid
  keyCardsIssued         Int?
  registrationCardSigned Boolean  @default(false)

  /// How the desk payment was taken, and any reference for it.
  ///
  /// Provisional in the same way `paidAmountMinor` is: a payment is properly a
  /// folio transaction with its own date, actor and reversal trail, and there
  /// is no Folio table. A cheque number recorded nowhere is a cheque nobody
  /// can chase, so these hold it until `FolioPayment` exists to own it.
  paymentMethod PaymentMethod?
  paymentRemark String?

  /// Whether this stay was quoted free of tax.
  ///
  /// Persisted because its absence is indistinguishable from the thing it
  /// must be distinguished from. 881 of 882 reservations record
  /// `taxAmountMinor = 0`, almost all because they predate tax being computed
  /// at all — so the folio derives the split from the property's configured
  /// rate. Without this flag a genuinely exempt booking (a diplomatic stay, an
  /// SEZ guest) would be taxed by that same derivation, and the first anyone
  /// would know is the invoice.
  isTaxExempt Boolean @default(false)

  /// Tax inside `totalAmountMinor`, in minor units.
  ///
  /// Provisional, and knowingly against the grain of section 3.4: tax belongs
  /// on its own folio line carrying a reference to the charge it derives from,
  /// never folded into a gross total. There is no Folio table yet, so the
  /// alternative is to compute tax at booking and then lose it — which would
  /// make every stored total un-reconcilable. Kept beside `paidAmountMinor`,
  /// which is provisional for exactly the same reason, and dropped the moment
  /// `folios` lands and real tax lines exist.
  taxAmountMinor Int @default(0)

  /// True while a self-service link (check-in, payment) is live for the guest.
  isMagicLinkActive Boolean @default(false)

  /// When the guest physically arrived and departed.
  ///
  /// Distinct from `arrivalDate` / `departureDate`, which are the *booked*
  /// calendar dates. These are instants, and they are what the hourly Day view
  /// of the reservation calendar positions a block against — without them the
  /// best it could do is assume everyone arrives at the property's standard
  /// desk time, which is exactly the guess an hourly view exists to replace.
  ///
  /// Null until the front desk checks the guest in or out, so a booking that
  /// has not arrived yet legitimately has neither. Written by the `frontdesk`
  /// module when it lands; until then only the seed populates them.
  checkedInAt  DateTime? @db.Timestamptz(6)
  checkedOutAt DateTime? @db.Timestamptz(6)

  /// When the booking was cancelled, for the master report's cancel-date
  /// column. An instant rather than a date: a cancellation inside the free
  /// window and one an hour later attract different retention, and only a
  /// timestamp can tell them apart. Guarded so it is set only on a cancelled
  /// or no-show booking.
  cancelledAt DateTime? @db.Timestamptz(6)

  /* -- Commercial attribution ------------------------------------------- */

  /// The operator's own reference, distinct from `confirmationCode`. A group
  /// booking taken against a tour operator's paperwork carries their number
  /// here so the two can be reconciled without overloading ours.
  bookingReferenceId String?

  /// Market segment, e.g. "Corporate", "OTA", "Leisure", "Group". Free text:
  /// segmentation is a commercial taxonomy that changes without a migration,
  /// and nothing in the domain branches on it.
  segment String?

  /// Front-desk flags.
  ///
  /// `scantyBaggage` marks a guest who arrived with little or no luggage,
  /// which most properties treat as a credit-risk signal worth recording at
  /// check-in. `isComplimentary` marks a stay given free of charge, and the
  /// remark is why — authorised by whom, against which budget. The remark is
  /// constrained to complimentary stays, because a reason for something that
  /// did not happen is a field nobody can interpret.
  scantyBaggage        Boolean @default(false)
  isComplimentary      Boolean @default(false)
  complimentaryRemarks String?

  /* -- OTA settlement ---------------------------------------------------- */

  /// What the channel actually settles, in integer minor units.
  ///
  /// ===========================================================================
  /// Four figures, not one derived from the others.
  ///
  /// `otaNetAmountMinor` is what the OTA *remits*, which is not reliably
  /// `total - commission - tax`: channels withhold differently, settle in
  /// batches, and adjust for cancellations after the fact. Storing the
  /// remittance separately is what lets a finance team reconcile a bank credit
  /// against the bookings it covers — deriving it would make every discrepancy
  /// invisible.
  ///
  /// `otaPrepaidAmountMinor` is the part the guest already paid the channel,
  /// which the property never touches and must not count as its own takings.
  ///
  /// Zero on a direct booking, which is the honest value rather than null: a
  /// walk-in has no OTA commission, it does not have an unknown one. Written
  /// by the `channels` module when it lands; until then only the seed sets
  /// them (CLAUDE.md section 2).
  /// ===========================================================================
  otaPrepaidAmountMinor Int @default(0)
  otaCommissionMinor    Int @default(0)
  otaTaxMinor           Int @default(0)
  otaNetAmountMinor     Int @default(0)

  /* -- Promotions -------------------------------------------------------- */

  /// The discount a promotion took off this booking, and the code that did it.
  /// Integer minor units like every other amount. A promotions module would own
  /// the catalogue of codes; this records which one was applied and for how
  /// much, which is what a report has to show either way.
  promoAmountMinor  Int     @default(0)
  appliedCouponCode String?

  /* -- Deposits ---------------------------------------------------------- */

  /// A refundable security deposit held against the stay.
  ///
  /// Deliberately not a folio payment line. A deposit is not revenue and is
  /// not a settlement of the bill — it is the property holding the guest's
  /// money, returnable at checkout. Counting it as a payment would understate
  /// the balance due and overstate the day's takings, which is why the folio's
  /// own deposits tab is still unbuilt rather than approximated.
  depositMinor Int @default(0)

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// The company billed for this stay, where it is a corporate booking.
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  rooms           ReservationRoom[]
  guests          ReservationGuest[]
  folio           Folio?
  internalNotes   ReservationNote[]

  @@unique([propertyId, confirmationCode], name: "reservation_unique_code_per_property")
  /// Idempotency for inbound OTA ingestion (CLAUDE.md section 5). Postgres
  /// treats NULLs as distinct in a unique index, so every direct booking
  /// coexists freely; only two bookings claiming the *same* channel reference
  /// collide, which is exactly the retry case this prevents.
  @@unique([propertyId, otaBookingId], name: "reservation_unique_ota_id_per_property")
  @@index([propertyId, arrivalDate])
  @@index([propertyId, departureDate])
  @@index([propertyId, status])
  /// Supports the dashboard's "new bookings today" count, which filters on
  /// when the booking was *made* rather than when the stay falls.
  @@index([propertyId, createdAt])
  @@index([propertyId, isMagicLinkActive])
  /// Supports the booking-source report, which groups by source across a date
  /// window. Without it that grouping scans every reservation in the portfolio
  /// on each dashboard load.
  @@index([propertyId, source, arrivalDate])
  /// Omnibar search paths. Each leads with propertyId, as every operational
  /// index must (CLAUDE.md section 3.2), so a search can never scan another
  /// hotel's rows even before the tenant filter is applied.
  ///
  /// These serve prefix and exact matches. A mid-string `contains` still scans,
  /// which is acceptable at this scale — ~900 reservations per property, and
  /// the planner has propertyId to narrow by first. A pg_trgm GIN index is the
  /// answer if that ever stops being true; it is not worth the write cost for
  /// ten hotels.
  @@index([propertyId, guestPhone])
  @@index([propertyId, govtIdNumber])
  @@index([propertyId, guestLastName])
  @@index([propertyId, guestFirstName])
  @@map("reservation")
}

/// One room of one reservation, for one date range.
///
/// A reservation may hold several rooms, each assignable to a different
/// physical room — or to none yet. `roomId` is nullable for that reason, and it
/// interacts with the exclusion constraint usefully: NULLs are not equal to one
/// another in GiST, so any number of unassigned rows coexist, and the
/// constraint starts biting the moment a number is given.
///
/// `status` is duplicated from the parent reservation deliberately. The partial
/// exclusion constraint needs the status in its own WHERE clause, and a
/// constraint cannot read another table. Keeping the two in step is the
/// aggregate's job (CLAUDE.md section 3.4).
model ReservationRoom {
  id String @id @default(uuid()) @db.Uuid

  propertyId String @db.Uuid

  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  /// Null until the front desk assigns a number.
  roomId String? @db.Uuid
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  arrivalDate   DateTime @db.Date
  departureDate DateTime @db.Date

  status ReservationStatus @default(CONFIRMED)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([propertyId, roomId, arrivalDate])
  @@index([propertyId, arrivalDate])
  @@index([reservationId])
  @@index([roomTypeId])
  @@map("reservation_room")
}

/// Everyone staying on one reservation.
///
/// ===========================================================================
/// `ordinal` 1 is the booker, whose name, phone and email are ALSO on
/// `reservation` — those columns are what search, the timeline and every
/// report read, and they are indexed for it. The copy is maintained in the
/// same transaction as this row, which is the only way two representations of
/// one fact stay honest (CLAUDE.md section 3.4 takes the same position on
/// materialised balances).
///
/// This table is not a guest *profile*. It is the guest list for one stay:
/// there is no identity shared across reservations, no stay history, no
/// merging of duplicates. That is the `frontdesk` module's work, and when it
/// lands this table gains a nullable `guestId` pointing at it rather than
/// being replaced.
/// ===========================================================================
model ReservationGuest {
  id String @id @default(uuid()) @db.Uuid

  propertyId String @db.Uuid

  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  /// 1 is the booker. 2..n are the accompanying adults.
  ordinal Int

  firstName String
  lastName  String  @default("")
  email     String?
  phone     String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  countryCode  String? @db.Char(2)

  gender      Gender?
  dateOfBirth DateTime? @db.Date
  nationality String?
  occupation  String?

  govtIdType   GovtIdType?
  govtIdNumber String?

  specialRequest String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// One row per position per reservation, and scoped by property like every
  /// other operational unique constraint (section 3.2).
  @@unique([propertyId, reservationId, ordinal], name: "reservation_guest_unique_ordinal")
  @@index([propertyId, reservationId])
  @@map("reservation_guest")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// A corporate account billed for stays.
///
/// ===========================================================================
/// `gstin` is unique **per property**, not globally. A global unique on it
/// would be a cross-tenant coupling bug: two hotels in this portfolio booking
/// the same corporate client — the ordinary case, not the exotic one — would
/// collide, and the second would be unable to create its own record
/// (CLAUDE.md section 3.2).
///
/// The trade is that the same company exists as one row per property. That is
/// correct here: billing address, contact and credit terms are negotiated per
/// hotel, and a shared row would force one hotel's edit onto another's
/// invoices.
/// ===========================================================================
model Company {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Legal name as it must appear on the tax invoice.
  legalName String
  /// Trading name, where it differs.
  tradeName String?

  /// 15 characters, validated by structure and checksum before it is stored.
  gstin String @db.Char(15)

  /// Provenance of `legalName`. See `GstinVerification`.
  gstinVerification GstinVerification @default(UNVERIFIED)
  /// Which provider answered, and when. Null when nobody was asked.
  gstinProvider     String?
  gstinVerifiedAt   DateTime?         @db.Timestamptz(6)

  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?
  email        String?
  phone        String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  reservations Reservation[]

  @@unique([propertyId, gstin], name: "company_unique_gstin_per_property")
  @@index([propertyId, legalName])
  @@map("company")
}

/// An internal note somebody wrote against a reservation.
///
/// ===========================================================================
/// Separate rows, not the free-text `Reservation.notes` field.
///
/// `Reservation.notes` is one string with no author and no timestamp, which is
/// fine for "late arrival, flight AI-302" captured at booking and useless for
/// a running log: two clerks editing it overwrite each other, and nothing
/// records who said what. The drawer needs a list with an author and a time,
/// so notes become rows.
///
/// The booking-time field stays where it is and is shown as the booking note.
/// Migrating it into this table would invent an author and a timestamp for
/// text that has neither.
///
/// Append-only by contract, like `FolioLine`: an internal note is part of how
/// a property explains a decision later, and silently editable history is
/// worth less than none.
/// ===========================================================================
model ReservationNote {
  id String @id @default(uuid()) @db.Uuid

  propertyId String @db.Uuid

  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  /// Staff member who wrote it. Null for a note the system generated.
  authorUserId String? @db.Uuid
  /// Their name as it was when they wrote it, so a renamed or departed
  /// account does not blank the byline on an old note.
  authorName String

  body String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId, reservationId, createdAt])
  @@map("reservation_note")
}

/// A property's operational configuration.
///
/// ===========================================================================
/// One row per property, holding what the front desk and the night audit need.
///
/// Separate from `Property` because these are settings an operator edits,
/// while `Property` is identity — the name, code and address that other
/// records point at. Mixing them means every settings change rewrites a row
/// that half the system joins against.
///
/// `checkInTime` and `checkOutTime` stay on `Property` as well, for now: the
/// calendar, the drawer and the folio all read them from there, and moving
/// them in one change would touch every one of those paths at once. This row
/// is the place they will move to, and `PropertyConfigService` already reads
/// through to it so the eventual move is a one-line change rather than a
/// migration of every caller.
/// ===========================================================================
model PropertySettings {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @unique @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Wall-clock times in the property's own timezone, `HH:MM`.
  standardCheckInTime  String @default("14:00")
  standardCheckOutTime String @default("11:00")

  /// Minutes between a departure and the next arrival, for housekeeping.
  turnaroundGraceMins Int @default(60)

  /// Prefixes for human-facing identifiers.
  bookingPrefix String @default("SFBOOKING_")
  folioPrefix   String @default("FOL_")
  invoicePrefix String @default("INV_")

  /// How long an unconfirmed hold survives before inventory is released.
  autoHoldReleaseHours Int @default(4)

  /// When the night audit is scheduled, in the property's timezone
  /// (CLAUDE.md section 3.3 — ten properties, ten independent schedules).
  nightAuditHour String @default("02:00")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("property_settings")
}

/// A GST slab: a tariff band and the rate that applies inside it.
///
/// ===========================================================================
/// Tax policy belongs in data, not in a constant.
///
/// Indian GST on room tariff is banded — the rate depends on what the room
/// costs per night, and the bands move when the Council says so. The platform
/// previously carried a single `property.taxRatePercent`, which forced every
/// room in a property onto one rate and made a rate change a code change.
///
/// `cgstRatePercent` and `sgstRatePercent` are stored rather than derived by
/// halving. Halving is right for an intra-state supply and wrong for an
/// inter-state one (which is IGST and is not split at all), and a Council
/// notification can in principle split a slab unevenly. Storing both means an
/// invoice prints what the slab says rather than what the code assumed.
///
/// `Decimal` here is correct and is not a money column: these are *rates*,
/// which section 3.4 explicitly permits as Decimal. The tariff bounds are
/// integer minor units like every other amount in this schema.
/// ===========================================================================
model PropertyTaxSlab {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  slabName String

  /// Inclusive lower bound of the nightly tariff, in minor units.
  minTariffMinor Int
  /// Exclusive upper bound, or null for the open-ended top band.
  maxTariffMinor Int?

  taxRatePercent  Decimal @db.Decimal(5, 2)
  cgstRatePercent Decimal @db.Decimal(5, 2)
  sgstRatePercent Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Two slabs of one property must not claim the same floor: which applies
  /// would then depend on row order, and a tariff would be taxed differently
  /// depending on how the planner happened to sort. Declared here rather than
  /// only in SQL so Prisma can use it as an upsert key — a hand-written index
  /// the client cannot see is an index the seed cannot upsert against.
  @@unique([propertyId, minTariffMinor], map: "property_tax_slab_unique_floor_per_property")
  @@map("property_tax_slab")
}

/// A photograph of the property.
model PropertyMedia {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  category MediaCategory
  url      String
  caption  String?

  sortOrder  Int     @default(0)
  isFeatured Boolean @default(false)

  /// Set where the photograph is of one room category rather than the property.
  roomTypeId String?   @db.Uuid
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId, category])
  @@map("property_media")
}

/// An amenity a property can offer.
///
/// Portfolio-wide reference data, so it carries no `propertyId` and is listed
/// in `global-tables.ts` (CLAUDE.md section 3.2). "Wi-Fi" means the same thing
/// at all ten hotels; what differs is whether a given hotel offers it and
/// charges for it, which is `PropertyAmenityLink`.
model Amenity {
  id String @id @default(uuid()) @db.Uuid

  slug      String  @unique
  name      String
  iconName  String?
  groupName String

  properties PropertyAmenityLink[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("amenity")
}

/// Whether a property offers an amenity, and at what price.
model PropertyAmenityLink {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  amenityId String  @db.Uuid
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  scope AmenityScope @default(FREE)

  /// Integer minor units, like every other amount (section 3.4). Zero when
  /// the amenity is free, which the scope already says.
  priceMinor  Int     @default(0)
  pricingUnit String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@map("property_amenity_link")
}

/// A policy a property publishes to guests.
model PropertyPolicy {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type        PolicyType
  title       String
  content     String
  isMandatory Boolean    @default(true)

  /// Structured cancellation terms, where the policy has them. Prose alone
  /// cannot be enforced by a cancellation path; these can.
  freeCancellationHours  Int?
  retentionChargePercent Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([propertyId, type])
  @@map("property_policy")
}

/// A fee or surcharge a property adds beyond the room tariff.
model FeeAndSurcharge {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name String
  type FeeType @default(FIXED_PER_STAY)

  /// Integer minor units for a fixed fee; basis points are not used — a
  /// percentage fee carries its rate in `ratePercent` instead, so neither
  /// field has to mean two things.
  amountMinor Int      @default(0)
  ratePercent Decimal? @db.Decimal(5, 2)

  isTaxable    Boolean @default(true)
  applyToGroup Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([propertyId])
  @@map("fee_and_surcharge")
}

/// A guest's bill for one stay.
///
/// ===========================================================================
/// One folio per reservation, and **no stored balance**.
///
/// Section 3.4 is explicit: a folio balance is always derived by summing its
/// integer lines, never cached in a mutable column. There is deliberately no
/// `balanceAmount` here — the only way to know what is owed is to add up the
/// ledger, so there is no second number able to drift from it.
///
/// `reservationId` is unique: a reservation has at most one folio. Group
/// masters and split folios need more than that, and when they arrive this
/// gains a nullable `parentFolioId` rather than losing the constraint — one
/// bill per booking is the right default and the wrong thing to relax early.
/// ===========================================================================
model Folio {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  reservationId String      @unique @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  status   FolioStatus @default(OPEN)
  currency String      @db.Char(3)

  openedAt DateTime  @default(now()) @db.Timestamptz(6)
  closedAt DateTime? @db.Timestamptz(6)

  /// The operator's own folio number, where they assign one.
  ///
  /// Distinct from `id`, which is a uuid nobody reads aloud, and from the
  /// property's `folioPrefix`, which only shapes a generated string. This is
  /// the number written on a paper registration card or quoted down the phone.
  /// Unique per property so two folios cannot claim the same one, and nullable
  /// because most properties never assign it.
  customFolioId String?

  lines FolioLine[]

  @@unique([propertyId, customFolioId], name: "folio_unique_custom_id_per_property")
  @@index([propertyId, status])
  @@map("folio")
}

/// One immutable line of a folio.
///
/// ===========================================================================
/// Append-only. Nothing here is ever updated or deleted.
///
/// A mistake is corrected by posting a reversing line that points at the
/// original through `reversesLineId`, which preserves the audit trail (section
/// 3.4). An `UPDATE` on this table is a bug, not an optimisation.
///
/// `amountMinor` is signed: charges positive, payments negative. That is what
/// makes the balance a plain `SUM(amountMinor)` with no per-kind branching —
/// and a branching sum is exactly where a payment eventually gets added
/// instead of subtracted.
///
/// The unique index on `(folioId, chargeDate)` for room charges is the
/// double-posting guard. Check-in posts the first night; the night audit posts
/// each subsequent night; both run the same insert. Without the constraint, a
/// re-run of either would charge a night twice and the guest would dispute a
/// bill the system insists is right.
/// ===========================================================================
model FolioLine {
  id String @id @default(uuid()) @db.Uuid

  propertyId String @db.Uuid

  folioId String @db.Uuid
  folio   Folio  @relation(fields: [folioId], references: [id], onDelete: Cascade)

  kind        FolioLineKind
  description String

  /// Integer minor units, signed. Never a float (section 3.4).
  amountMinor Int
  currency    String @db.Char(3)

  /// The business date this line belongs to, never `now()` (section 3.3).
  chargeDate DateTime @db.Date

  /// For a TAX line: the charge it was computed from.
  derivedFromLineId String?     @db.Uuid
  derivedFrom       FolioLine?  @relation("TaxDerivation", fields: [derivedFromLineId], references: [id], onDelete: SetNull)
  derivedTax        FolioLine[] @relation("TaxDerivation")

  /// For a correction: the line it cancels.
  reversesLineId String?     @db.Uuid
  reverses       FolioLine?  @relation("Reversal", fields: [reversesLineId], references: [id], onDelete: SetNull)
  reversedBy     FolioLine[] @relation("Reversal")

  /// Staff member who posted it. Null for lines posted by the night audit.
  postedById String? @db.Uuid

  /// Method and reference, for a PAYMENT or REFUND line.
  paymentMethod PaymentMethod?
  remark        String?

  /// Instrument detail, for a payment taken by card.
  ///
  /// ===========================================================================
  /// The last four digits and the issuer, and deliberately nothing else.
  ///
  /// Four digits identify a card to a guest disputing a charge, which is what
  /// a report column is for. A PAN, an expiry or a CVV would put this database
  /// in scope for PCI DSS, and nothing here is built to that standard — so the
  /// schema makes storing them impossible rather than leaving it to a reviewer
  /// to notice. `@db.Char(4)` plus a digits-only CHECK is the whole guarantee.
  ///
  /// `paymentIssuer` is the bank or network as the terminal reported it, e.g.
  /// "HDFC Bank" or "RuPay". Free text because it comes from whatever the
  /// gateway hands back, not from a list this repository controls.
  /// ===========================================================================
  cardLast4     String? @db.Char(4)
  paymentIssuer String?

  /// Where the money was taken.
  ///
  /// `isExternalSource` marks a payment collected by someone other than the
  /// property — an OTA or a travel agent passing on what it already holds.
  /// `isExternalCard` marks one taken on a terminal outside this system, so
  /// it reconciles against a different settlement file. Both default false,
  /// which is a payment taken at this desk on this property's own instrument.
  isExternalSource Boolean @default(false)
  isExternalCard   Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// The client's reference for the payment intent this line records.
  ///
  /// ===========================================================================
  /// Null for every line the system raises on its own behalf.
  ///
  /// A night audit posting a room charge, check-in posting the arrival night,
  /// a tax line derived from a charge and a correction are all system-generated
  /// from an act that is already guarded somewhere else -- the room charge by
  /// `folio_line_one_room_charge_per_date`, a correction by the id of the line
  /// it corrects. None of them has a client intent to deduplicate, so none of
  /// them carries a key, and the unique index below ignores them: PostgreSQL
  /// treats NULLs as distinct in a unique index, so unlimited keyless lines
  /// coexist with no partial-index trickery.
  ///
  /// Nullable is also what makes this migration safe on a live table: every
  /// existing row is valid unchanged.
  idempotencyKey String?

  @@unique([propertyId, idempotencyKey], name: "folio_line_unique_idempotency_key")
  @@index([propertyId, folioId, chargeDate])
  @@index([propertyId, kind, chargeDate])
  @@map("folio_line")
}

/// Who changed what, and to what.
///
/// ===========================================================================
/// Required by section 3.4: every mutation of money, reservation state, rates
/// or restrictions writes a row here **in the same transaction as the change**.
/// Written afterwards it would be a log that disagrees with the database the
/// first time a transaction rolled back.
///
/// `before` and `after` are JSON snapshots of the fields that moved, not whole
/// rows — a whole-row snapshot makes every column change a schema change here
/// too, and buries the one field that actually moved.
///
/// Guest PII never goes in either side. Section 5 forbids logging it, and an
/// audit table is the most copied, exported and long-lived place in a system.
/// ===========================================================================
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Staff member responsible. Null for a system actor like the night audit.
  actorUserId String? @db.Uuid

  /// Machine-readable, e.g. `RESERVATION_CHECKED_IN`.
  event String

  /// What was changed: `reservation`, `folio`, `room`.
  entityType String
  entityId   String @db.Uuid

  before Json?
  after  Json?

  /// Why, where the actor supplied a reason.
  reason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId, createdAt])
  @@index([propertyId, entityType, entityId])
  @@map("audit_log")
}

/// A property's payment-gateway onboarding state.
///
/// Drives the operational alert on the property dashboard: a property stuck in
/// PENDING_KYC cannot take card payments, and the front desk needs to know
/// that before a guest tries to pay rather than after.
///
/// One row per (property, provider) so a property can migrate between
/// providers without losing the old record.
model PaymentGatewayConfig {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  provider PaymentGatewayProvider
  status   PaymentGatewayStatus   @default(PENDING_KYC)

  /// Provider-side merchant identifier. Not a secret; API keys are never
  /// stored in the database (CLAUDE.md section 5) — they come from the
  /// environment at the point of use.
  merchantId String?

  /// When onboarding should have been finished, for the OVERDUE badge.
  onboardingDueDate DateTime? @db.Date
  activatedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, provider], name: "gateway_unique_provider_per_property")
  @@index([propertyId, status])
  @@map("payment_gateway_config")
}

/* -------------------------------------------------------------------------- */
/*  Transactional outbox                                                      */
/* -------------------------------------------------------------------------- */

/// What an outbox row asks to be done.
///
/// Explicit, not free text: a worker dispatches on this value, and a typo in a
/// string would silently route an event to no handler at all. Phase A carries
/// exactly one type, which is a deliberate self-test and has no business
/// meaning -- real ARI event types land with the `channels` module, once the
/// provider contract is known (CLAUDE.md section 2).
enum OutboxEventType {
  /// Exercises the outbox end to end. Handled by a fake handler; touches
  /// nothing outside the outbox tables.
  OUTBOX_SELF_TEST
}

/// How a row's `dedupeKey` constrains other rows.
///
/// ===========================================================================
/// The two classes are not interchangeable, and conflating them is a bug in
/// both directions.
///
/// **COALESCE** -- "the latest intent wins". An ARI push for
/// `(property, roomType, dateRange)` enqueued five times before the worker
/// drains it should become *one* push carrying the newest state, not five.
/// Uniqueness therefore applies only while a row is still PENDING: once it has
/// been processed, the same key may legitimately be enqueued again tomorrow.
///
/// **UNIQUE_FOREVER** -- "this must happen at most once, ever". A booking
/// confirmation email for reservation X must not be sent twice, and must not
/// become sendable again merely because the first one succeeded. Uniqueness
/// therefore ignores status and holds for the lifetime of the row.
///
/// A PENDING-only constraint is *not* permanent idempotency, which is why the
/// mode is stored per row and enforced by two different partial unique indexes
/// rather than one.
/// ===========================================================================
enum OutboxDedupeMode {
  COALESCE
  UNIQUE_FOREVER
}

/// Where an outbox row is in its lifecycle.
///
/// `IN_FLIGHT` is held under a **lease**, not a lock: see
/// `OutboxEvent.leaseExpiresAt`. A worker that dies mid-job cannot leave a row
/// stranded, because the lease expires and the row returns to PENDING.
enum OutboxStatus {
  /// Waiting for `availableAt` to pass, then publication.
  PENDING
  /// Claimed by a dispatcher or being handled. Lease-bound.
  IN_FLIGHT
  /// Handled successfully. Terminal.
  SUCCEEDED
  /// Attempts exhausted. Terminal until deliberately requeued. This is the
  /// dead-letter state CLAUDE.md section 5 requires, and it must alert.
  DEAD
}

/// A side effect recorded inside the transaction that caused it.
///
/// ===========================================================================
/// PostgreSQL is the source of truth. Redis is a delivery mechanism.
///
/// CLAUDE.md section 3.1 forbids HTTP calls, queue publishes and Redis reads
/// inside a transaction, and requires side effects to leave through an outbox
/// drained by a BullMQ worker. This table is that outbox.
///
/// Everything needed to rebuild the queue lives here. If Redis is flushed
/// entirely, the dispatcher re-publishes from these rows and nothing is lost;
/// there is deliberately **no** attempt at an atomic transaction spanning
/// PostgreSQL and Redis, because none is available. The consequence is
/// at-least-once delivery, never exactly-once -- so every handler must be safe
/// to run twice.
///
/// RETRY SCHEDULING LIVES HERE, NOT IN BULLMQ. Jobs are published with
/// `attempts: 1`, so BullMQ never retries on its own. On failure the worker
/// writes `attempts`, `availableAt` and `lastError` to this row and returns it
/// to PENDING. One scheduler, one counter, so the database and the queue
/// cannot disagree about how many times something has been tried.
///
/// PAYLOADS CARRY NO PII AND NO SECRETS. A row is a *reference* to work --
/// identifiers and a date range -- never a guest's name, email, address,
/// government ID or card data, and never a credential. The handler re-reads
/// what it needs from the database under the current tenant scope.
/// ===========================================================================
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid

  /// Tenant scope (CLAUDE.md section 3.2). Every operational row carries it,
  /// and a handler uses it to re-establish scope when it re-reads data.
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  eventType OutboxEventType

  /// Schema version of `payload`, so a worker deployed before a payload change
  /// can refuse a shape it does not understand instead of misreading it.
  /// Validated against a zod schema at enqueue *and* again at handling.
  payloadVersion Int @default(1)

  /// The event body. Identifiers and scalars only -- see the PII note above.
  payload Json

  /// Groups rows that mean the same work. Interpreted according to
  /// `dedupeMode`; see `OutboxDedupeMode`.
  dedupeKey  String
  dedupeMode OutboxDedupeMode @default(COALESCE)

  status OutboxStatus @default(PENDING)

  /// Attempts already made. Owned by this table, never by BullMQ.
  attempts    Int @default(0)
  maxAttempts Int @default(5)

  /// How many times a stale lease was reclaimed. Distinct from `attempts`: a
  /// reclaim means a worker died, which is an operational signal rather than a
  /// handler failure, and must not consume the retry budget.
  recoveries Int @default(0)

  /// Earliest moment this row may be published. Backoff writes the future here.
  availableAt DateTime @default(now()) @db.Timestamptz(6)

  /// Lease bookkeeping for IN_FLIGHT rows.
  claimedAt      DateTime? @db.Timestamptz(6)
  leaseExpiresAt DateTime? @db.Timestamptz(6)
  /// Which process holds the lease. For diagnosis only; never authorisation.
  claimedBy      String?

  /// Safe failure metadata: an error class and a truncated message, scrubbed
  /// of anything resembling a payload. Never a stack trace, never SQL, never
  /// a provider response body.
  lastError   String?   @db.VarChar(500)
  lastErrorAt DateTime? @db.Timestamptz(6)

  completedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// The drain query: due rows, oldest first. Deliberately NOT led by
  /// `propertyId`, unlike every other composite index in this schema.
  ///
  /// CLAUDE.md section 3.2 requires tenant-led indexes on operational data and
  /// permits cross-property reads for night-audit orchestration. The dispatcher
  /// is exactly that kind of process: one system loop draining every property,
  /// which cannot lead with a tenant it does not have. Leading with
  /// `propertyId` here would make the only hot query in this table unindexed.
  @@index([status, availableAt])

  /// Lease reaping: find IN_FLIGHT rows whose lease has expired.
  @@index([status, leaseExpiresAt])

  /// Tenant-led, for the operator-facing view of a property's backlog.
  @@index([propertyId, status, createdAt])

  @@map("outbox_event")
}
