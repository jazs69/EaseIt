// =============================================================================
// EaseIt — multi-tenant Hotel PMS schema
// -----------------------------------------------------------------------------
// Tenancy model (CLAUDE.md section 3.2): one PostgreSQL database, row-level
// isolation keyed on `propertyId`. Three kinds of table exist here:
//
//   * Tenant root       — `Property`.
//   * Tenant-scoped     — carries `propertyId`, every composite index leads
//                         with it: `UserPropertyRole`, and custom `Role` rows.
//   * Portfolio catalog — shared by all 10 hotels, no `propertyId`:
//                         `Permission`, and system `Role` templates.
//   * Identity          — attached to `User`, not to a property, and therefore
//                         also without `propertyId`: `TwoFactorChallenge`.
//
// `User` is portfolio-wide identity: one person, one credential, even when
// they work at three hotels. Authority is never implied by the user row — it
// comes only from `UserPropertyRole`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// Prisma 7 removed `url` / `directUrl` from the schema: connection strings for
// Migrate now live in prisma.config.ts, and the runtime connection comes from
// the driver adapter passed to the PrismaClient constructor (see src/index.ts).
datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Mirrors `Role` in @repo/types/rbac. Set on system role templates only;
/// custom roles have a null `key`. The seed asserts the two stay in lockstep.
enum RoleKey {
  SUPER_ADMIN
  PROPERTY_ADMIN
  FRONT_DESK
  HOUSEKEEPING
  REVENUE_MANAGER
  NIGHT_AUDITOR
  POS_STAFF
}

/// Mirrors `PropertyStatus` in @repo/types/domain. Replaces the former
/// `isActive` boolean: a property that is being onboarded is neither live nor
/// retired, and a boolean cannot say so (CLAUDE.md section 3.4 — status is a
/// state machine, not a free-form string, and not a flag either).
enum PropertyStatus {
  /// Trading. The only status the booking engine will sell.
  ACTIVE
  /// Being configured. Staff may sign in; it is not sellable.
  ONBOARDING
  /// Retired. Read-only for reporting and audit history.
  INACTIVE
}

/// Mirrors `ReservationStatus` in @repo/types/domain. The legal transitions
/// between these live in one place in the domain layer, never in a controller
/// or a bare Prisma update (CLAUDE.md section 3.4).
enum ReservationStatus {
  /// Held, not confirmed. Expires, and does NOT consume inventory.
  TENTATIVE
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  /// Awaiting payment or a decision. Holds a room but is not yet a sale, so
  /// like TENTATIVE it does not consume inventory.
  ON_HOLD
}

/// Board basis. An enum rather than a free-form string: these four are the
/// whole set, and a typo in a string column silently becomes a rate the
/// pricing code cannot interpret (CLAUDE.md section 3.4).
enum MealPlan {
  /// European — room only.
  EP
  /// Continental — breakfast.
  CP
  /// Modified American — breakfast and one meal.
  MAP
  /// American — all meals.
  AP
}

enum PaymentGatewayProvider {
  RAZORPAY
  STRIPE
}

enum PaymentGatewayStatus {
  /// Onboarding started, identity checks outstanding. Cannot take payments.
  PENDING_KYC
  ACTIVE
  INACTIVE
}

/// Mirrors `RoomStatus` in @repo/types/domain.
enum RoomStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED_CLEAN
  OCCUPIED_DIRTY
  INSPECTED
  /// Temporarily unsellable (maintenance). Still counted as physical stock.
  OUT_OF_SERVICE
  /// Unsellable and NOT counted as physical stock.
  OUT_OF_ORDER
}

/// Where a photograph was taken.
enum MediaCategory {
  EXTERIOR
  INTERIOR
  RECEPTION
  ROOM_BEDROOM
  ROOM_WASHROOM
  AMENITY_BANQUET
  AMENITY_POOL
  AMENITY_GARDEN
  PARKING
  RESTAURANT
  OTHERS
}

/// Whether an amenity is included or charged for.
enum AmenityScope {
  FREE
  PAID
}

/// The kind of policy a property publishes.
enum PolicyType {
  CANCELLATION
  AMENDMENT
  CHECK_IN_CHECK_OUT
  HOUSE_RULES
  TERMS_AND_CONDITIONS
  CUSTOM
}

/// How a fee is computed.
enum FeeType {
  PERCENTAGE
  FIXED_PER_NIGHT
  FIXED_PER_STAY
  FIXED_PER_GUEST
}

/// What a folio line represents.
///
/// One table with a discriminator rather than separate charge and payment
/// tables. CLAUDE.md section 3.4 requires a folio balance to be derived by
/// summing its lines; across two tables that sum spans two queries, two
/// reversal paths and two chances to disagree. One ledger, signed amounts,
/// one sum.
enum FolioLineKind {
  /// Nightly room tariff for one business date.
  ROOM_CHARGE
  /// Tax derived from a specific charge, carrying `derivedFromLineId`.
  TAX
  /// Food, laundry, minibar — anything posted by an outlet.
  SERVICE_CHARGE
  /// Money received. Stored negative, so the balance is a plain sum.
  PAYMENT
  /// Money returned. Stored positive.
  REFUND
  /// A manual correction, always paired with `reversesLineId`.
  ADJUSTMENT
}

enum FolioStatus {
  /// Accepting postings. Exactly one open folio per reservation.
  OPEN
  /// Settled and closed by the night audit or at check-out.
  CLOSED
  /// Moved to another folio, e.g. a group master.
  TRANSFERRED
}

/// Where a company's legal name came from.
///
/// Recorded permanently, because the three are not interchangeable on a tax
/// invoice. MOCK exists so synthetic development data stays identifiable after
/// it is saved — without it, a company created against the mock provider is
/// indistinguishable from a verified one the moment the request ends, which is
/// precisely the confusion that makes a fake legal name dangerous.
enum GstinVerification {
  /// Structure and check digit only. The operator typed the name.
  UNVERIFIED
  /// Synthetic data from the development provider. Never trust on an invoice.
  MOCK
  /// Confirmed against the GST registry by a live provider.
  VERIFIED
}

/// How a payment was taken at the desk.
enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
  /// GP-07: the folio balance was billed to the stay's company account. Written
  /// only by the bill-to-company transfer, never chosen as a way to pay, and no
  /// money was received: payment totals and the night-audit snapshot leave it out.
  CITY_LEDGER
}

/// The kind of government photo ID recorded at check-in.
///
/// An enum, not a free string: the set is fixed by what Indian hotels may
/// legally accept, and a typo'd "passprt" would silently create a category
/// nobody can report on (CLAUDE.md section 5).
enum GovtIdType {
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  PAN
}

/// Mirrors `BookingSource` in @repo/types/domain.
///
/// Two granularities live in one field, deliberately. The original members are
/// a source *type* (how the booking arrived); the named OTAs below are a
/// channel *identity*. Keeping them in one enum is what lets a reservation say
/// "Agoda" rather than the useless "OTA", which is what the booking-source
/// report needs — and it stays additive, so no existing row changes meaning.
///
/// When the `channels` module lands it owns channel identity properly (a
/// mapping row per property per channel, per CLAUDE.md section 2) and these
/// named members become a foreign key. Until then this is the only place a
/// booking can record which OTA sold it.
///
/// Note there is no `DIRECT_WEBSITE`: that is `DIRECT_WEB`, already here. Two
/// members meaning one thing is exactly the near-synonym trap section 6.1
/// warns about — the report labels it "DIRECT WEBSITE" at the presentation
/// layer instead.
enum BookingSource {
  DIRECT_WEB
  FRONT_DESK
  PHONE
  WALK_IN
  OTA
  CORPORATE
  TRAVEL_AGENT

  /// Named OTAs. `OTA` remains for a channel with no member of its own.
  MAKEMYTRIP
  AGODA
  BOOKING_COM
  EXPEDIA
  CLEARTRIP
}

/// Mirrors `PermissionCategory` in @repo/types/rbac. Drives the grouping of
/// the permission matrix in the admin role editor.
enum PermissionCategory {
  FRONT_DESK
  HOUSEKEEPING
  BILLING
  RATES_DISTRIBUTION
  NIGHT_AUDIT
  ADMINISTRATION
}

// -----------------------------------------------------------------------------
// Property — the tenant root
// -----------------------------------------------------------------------------

model Property {
  id   String @id @default(uuid()) @db.Uuid
  /// URL-safe tenant key. Resolved server-side by the booking engine; never
  /// trusted from a client header (CLAUDE.md section 3.2).
  slug String @unique
  /// Short operator-facing identifier, e.g. "31336". What staff say on the
  /// phone and what appears on printed folios; distinct from `slug`, which is
  /// a URL segment, and from `id`, which is never shown to anybody.
  code String @unique
  name String

  legalName String?

  /// Optional brand mark for the group dashboard. Null falls back to initials
  /// rendered client-side, so a missing logo is never a broken image.
  logoUrl String?

  /// Operating region this property reports under, e.g. "Bhopal Division".
  /// Free text: divisions are an org-chart concern that changes without a
  /// migration, and nothing in the domain branches on it.
  division String?

  /// IANA zone, e.g. "Asia/Kolkata". Drives this property's night-audit
  /// schedule — ten properties means ten independent schedules.
  timezone String @default("Asia/Kolkata")
  /// ISO-4217. Every monetary amount stored against this property is an
  /// integer count of this currency's minor unit (CLAUDE.md section 3.4).
  currency String @default("INR") @db.Char(3)
  locale   String @default("en-IN")

  /// The property's open accounting day. A calendar date, NOT a timestamp,
  /// advanced only by the night audit's business-date-roll step.
  businessDate DateTime @db.Date

  /// Local wall-clock times, "HH:MM".
  /// Flat GST percentage applied to room tariff, or null for statutory slabs.
  ///
  /// ===========================================================================
  /// A `Decimal`, which section 3.4 permits for tax *rates* — it bans Decimal
  /// for money, not for percentages.
  ///
  /// Null means the statutory room-tariff treatment: 12% below ₹7,500 a night
  /// and 18% at or above it. A value overrides that with a flat rate for every
  /// tariff.
  ///
  /// This exists because the rate is a per-property configuration, not a
  /// constant — section 3.4 already requires inclusive-vs-exclusive tax to be
  /// a property setting, and the rate belongs with it. Hard-coding one number
  /// means a rate change ships as a deployment, and a wrong one cannot be
  /// corrected at all.
  /// ===========================================================================
  taxRatePercent Decimal? @db.Decimal(5, 2)

  checkInTime  String @default("14:00")
  checkOutTime String @default("11:00")

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  countryCode  String  @default("IN") @db.Char(2)
  phone        String?
  email        String?

  /// Supersedes the former `isActive` boolean. One column, one truth: a
  /// property cannot be simultaneously active and onboarding.
  status PropertyStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Roles this property has defined for itself (isCustom = true).
  customRoles Role[]
  staffRoles  UserPropertyRole[]

  roomTypes         RoomType[]
  rooms             Room[]
  inventoryDays     InventoryDay[]
  roomBlocks        RoomBlock[]
  ratePlans         RatePlan[]
  ratePlanRooms     RatePlanRoomType[]
  ratePlanDays      RatePlanDay[]
  restrictions      RateRestrictionDay[]
  pricingRules      RatePricingRule[]
  pricingPrices     RatePricingRulePrice[]
  promotions        Promotion[]
  promotionPlans    PromotionRatePlan[]
  promotionRooms    PromotionRoomType[]
  promoCodes        PromoCode[]
  redemptions       PromotionRedemption[]
  reservations      Reservation[]
  pricedNights      ReservationNight[]
  gatewayConfigs    PaymentGatewayConfig[]
  paymentLinks      PaymentLink[]
  workOrders        WorkOrder[]
  companies         Company[]
  folios            Folio[]
  invoices          Invoice[]
  invoiceSequences  InvoiceSequence[]
  auditLogs         AuditLog[]
  outboxEvents      OutboxEvent[]
  nightAuditRuns    NightAuditRun[]
  dailySnapshots    DailySnapshot[]
  housekeepingTasks HousekeepingTask[]
  settings          PropertySettings?
  taxSlabs          PropertyTaxSlab[]
  media             PropertyMedia[]
  amenityLinks      PropertyAmenityLink[]
  policies          PropertyPolicy[]
  fees              FeeAndSurcharge[]
  guestProfiles     GuestProfile[]
  companyLedger     CompanyLedgerEntry[]

  @@index([status])
  @@map("property")
}

// -----------------------------------------------------------------------------
// User — portfolio-wide identity
// -----------------------------------------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Globally unique across the portfolio. Deliberately not scoped by
  /// property: one human holds one credential and is granted access per
  /// property through UserPropertyRole.
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime? @db.Timestamptz(6)

  /// Whether sign-in requires the emailed second factor.
  ///
  /// Defaults to **true**, and that direction matters: a new account is
  /// protected unless somebody deliberately weakens it, rather than exposed
  /// until somebody remembers to protect it. A PMS login opens folios, refunds
  /// and rate overrides, so the safe default is the strict one.
  ///
  /// Setting this false is a real reduction in security and is honoured only
  /// because some integration accounts cannot receive mail. The login path
  /// answers `authenticated` instead of `two_factor_required` for those, which
  /// the `loginResultSchema` discriminated union already models.
  isTwoFactorEnabled Boolean @default(true)

  /// Sessions issued before this instant are refused.
  ///
  /// How signing out actually ends a session. The session token is a stateless
  /// JWT, so clearing the cookie stops *this* browser sending it but cannot
  /// stop a copy of it being replayed until it expires — up to eight hours.
  /// Signing out stamps this, and the guard refuses any token whose `iat` is
  /// older, which revokes every session that user holds.
  ///
  /// One nullable column rather than a session table or a Redis denylist: the
  /// guard already loads this row on every request to check `isActive`, so the
  /// check costs one more selected column and no extra query. A denylist would
  /// add a datastore to maintain and expire for the same effect (CLAUDE.md
  /// section 6.4).
  sessionsValidFrom DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  propertyRoles       UserPropertyRole[]
  twoFactorChallenges TwoFactorChallenge[]
  authTokens          AuthToken[]

  @@index([isActive])
  @@map("user")
}

// -----------------------------------------------------------------------------
// TwoFactorChallenge — the outstanding second factor
// -----------------------------------------------------------------------------

/// One email-OTP challenge: created when a password check succeeds, consumed
/// when the matching code arrives, and useless afterwards.
///
/// Not tenant-scoped. It hangs off portfolio-wide `User` identity exactly as
/// the credential itself does, so it carries no `propertyId` and is listed in
/// `PORTFOLIO_GLOBAL_MODELS` (CLAUDE.md section 3.2). `requestedPropertyId` is
/// a *preference* carried through from the login request — step 2 re-verifies
/// the grant before honouring it, so it never confers access.
///
/// The code itself is never stored. `codeHash` is an HMAC-SHA256 of the digits
/// under a server-side pepper, so a database dump alone cannot be turned back
/// into a working code: a six-digit space is small enough that an unkeyed
/// digest of it is equivalent to plaintext.
model TwoFactorChallenge {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The address the code was sent to, snapshotted at issue time. If the
  /// account's email changes mid-challenge, the audit trail still records
  /// where the code actually went.
  email String

  /// HMAC-SHA256(code, pepper), lowercase hex. Never the code.
  codeHash String

  /// When the *current* code stops working. A resend replaces both.
  expiresAt  DateTime @db.Timestamptz(6)
  /// Start of the resend cooldown for the current code.
  lastSentAt DateTime @db.Timestamptz(6)

  /// Wrong codes so far. At TWO_FACTOR.MAX_ATTEMPTS the challenge is burned.
  attempts    Int @default(0)
  /// Codes re-issued so far, capped at TWO_FACTOR.MAX_RESENDS.
  resendCount Int @default(0)

  /// Set exactly once, by the verification that succeeded. The write is
  /// guarded on this still being null, which is what makes a single code
  /// single-use even if two requests race.
  consumedAt DateTime? @db.Timestamptz(6)
  /// Set when the challenge is abandoned: attempts exhausted, or superseded by
  /// a newer sign-in attempt from the same account.
  revokedAt  DateTime? @db.Timestamptz(6)

  /// The property the operator asked to work in, if they named one. A request,
  /// never an assertion — re-checked against UserPropertyRole at step 2.
  requestedPropertyId String? @db.Uuid

  /// Forensics for a suspicious sign-in. Deliberately not the full header set:
  /// no PII beyond what a login already implies (CLAUDE.md section 5).
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Finding a user's live challenges, newest first.
  @@index([userId, createdAt])
  /// Sweeping expired rows.
  @@index([expiresAt])
  @@map("two_factor_challenge")
}

// -----------------------------------------------------------------------------
// Role — system template (propertyId null) or property-custom
// -----------------------------------------------------------------------------

/// A named bundle of permissions.
///
/// `propertyId == null` is a **system template**, shared read-only by the
/// whole portfolio and seeded from DEFAULT_ROLE_PERMISSIONS. `propertyId` set
/// is a **custom role** owned by that property — for example a combined
/// "Front Desk & Night Auditor" for a small hotel where one person covers
/// both. Custom roles are the only ones an administrator may edit or delete.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String  @default("")
  isCustom    Boolean @default(false)

  /// Set on system templates, null on custom roles. Lets the application map
  /// a row back to the typed `Role` union in @repo/types.
  key RoleKey?

  /// Null for a system template; set for a role owned by one property.
  propertyId String?   @db.Uuid
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  permissions RolePermission[]
  assignments UserPropertyRole[]

  // A property cannot have two roles with the same name. System templates are
  // covered by a partial unique index on `key` added in the migration, since
  // PostgreSQL treats NULL propertyIds as distinct and this constraint would
  // not catch duplicates among them.
  @@unique([propertyId, name], name: "role_unique_name_per_property")
  @@index([propertyId])
  @@index([isCustom])
  @@map("role")
}

// -----------------------------------------------------------------------------
// Permission — portfolio catalog
// -----------------------------------------------------------------------------

/// The authoritative list of grantable actions, seeded from
/// PERMISSION_DEFINITIONS in @repo/types.
///
/// Modelled as a table rather than a bare string column on RolePermission so
/// that a typo cannot become a silently unenforceable grant: the foreign key
/// rejects any key that is not in the catalog.
model Permission {
  id String @id @default(uuid()) @db.Uuid

  /// `module:action`, e.g. "reservations:checkin". A wire contract shared with
  /// @repo/types: additive only, never renamed.
  key         String             @unique
  label       String
  description String
  category    PermissionCategory
  /// True when granting this lets the holder move money or reduce revenue.
  sensitive   Boolean            @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@index([category])
  @@map("permission")
}

/// Join between a role and the permissions it grants.
model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// -----------------------------------------------------------------------------
// UserPropertyRole — the tenant-scoped grant
// -----------------------------------------------------------------------------

/// The row that actually confers access: this user holds this role at this
/// property.
///
/// Multiple rows per (user, property) are expected and supported — a clerk at
/// a small hotel may hold both Front Desk and Night Auditor, and their
/// effective permissions are the union of the two. The same user may equally
/// hold different roles at different properties.
model UserPropertyRole {
  id String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid
  propertyId String @db.Uuid
  roleId     String @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Audit trail: who granted this and when (CLAUDE.md section 3.4).
  grantedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([userId, propertyId, roleId], name: "user_property_role_unique")
  // Tenant-scoped reads lead with propertyId, per CLAUDE.md section 3.2.
  @@index([propertyId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("user_property_role")
}

// =============================================================================
// Inventory and reservations
// -----------------------------------------------------------------------------
// This is the part of the schema CLAUDE.md section 3.1 governs, and the only
// part where the *database* rather than the application is the guarantee. Two
// constraints carry that weight, neither is expressible in Prisma, so both live
// in hand-written SQL in the migration and must never be dropped:
//
//   1. inventory_day_not_oversold
//        CHECK (sold + blocked <= physical + overbookingAllowance)
//      Selling a room is an UPDATE that increments `sold` on each stay date. A
//      losing concurrent booking fails this and its transaction rolls back,
//      which is correct under any isolation level.
//
//   2. reservation_room_no_overlap
//        EXCLUDE USING gist (roomId WITH =, daterange(...) WITH &&)
//        WHERE (status NOT IN ('CANCELLED','NO_SHOW'))
//      The same physical room can never hold two overlapping stays.
//
// Departure day is exclusive, so every range is half-open: a room checked out
// in the morning is sellable that same night.
// =============================================================================

/// A sellable category of room, e.g. "Deluxe Suite".
///
/// Availability is counted per room *type* per date (see InventoryDay), not per
/// physical room: guests book a category, and the front desk assigns a number
/// later — often not until check-in.
model RoomType {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Short operator-facing code, e.g. "DLX". Unique within the property.
  code        String
  name        String
  description String?

  maxGuests Int
  maxAdults Int?

  /// Rack rate in the currency's **minor unit** — paise for INR, so 3500 INR
  /// is 350000 (CLAUDE.md section 3.4). Never a float, never a major-unit
  /// decimal. Paired with `currency`, so an amount is never ambiguous.
  baseRateMinor Int
  currency      String @db.Char(3)

  /// Default allowance copied onto new InventoryDay rows. Overbooking is only
  /// ever deliberate; it is never a side effect of a race (section 3.1).
  overbookingAllowance Int @default(0)

  sortOrder Int @default(0)

  /// Set once, never cleared: a retired category is no longer sold. Null while active.
  retiredAt       DateTime? @db.Timestamptz(6)
  retiredByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  rooms            Room[]
  inventoryDays    InventoryDay[]
  roomBlocks       RoomBlock[]
  reservationRooms ReservationRoom[]
  media            PropertyMedia[]
  ratePlans        RatePlanRoomType[]
  promotions       PromotionRoomType[]

  @@unique([propertyId, code], name: "room_type_unique_code_per_property")
  @@unique([propertyId, name], name: "room_type_unique_name_per_property")
  @@index([propertyId, sortOrder])
  @@map("room_type")
}

/// A physical, numbered room.
model Room {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  /// "101". Unique within the property, not globally.
  number String
  floor  String?

  /// Housekeeping state. OUT_OF_ORDER rooms drop out of physical stock when
  /// inventory is rebuilt; OUT_OF_SERVICE rooms stay counted.
  status RoomStatus @default(VACANT_CLEAN)

  notes String?

  /// Set once, never cleared: a retired room is never assigned or counted as stock. Null while active.
  retiredAt       DateTime? @db.Timestamptz(6)
  retiredByUserId String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  reservationRooms  ReservationRoom[]
  roomBlocks        RoomBlock[]
  housekeepingTasks HousekeepingTask[]

  workOrders WorkOrder[]

  @@unique([propertyId, number], name: "room_unique_number_per_property")
  @@index([propertyId, roomTypeId])
  @@index([propertyId, status])
  @@map("room")
}

/// One row per (property, room type, stay date): the availability counter.
///
/// This table *is* the oversell guarantee. The CHECK added in the migration
/// physically cannot hold a row where more rooms are sold and blocked than
/// exist, so two concurrent bookings for the last room cannot both commit —
/// one fails the constraint and rolls back entirely.
model InventoryDay {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  /// A calendar date, never an instant. Built from the property's own timezone,
  /// never from a client's local time (CLAUDE.md section 3.3).
  stayDate DateTime @db.Date

  /// Sellable rooms of this type on this date, excluding OUT_OF_ORDER.
  physical Int
  /// Rooms consumed by non-cancelled reservations.
  sold     Int @default(0)
  /// Rooms withheld from sale: maintenance, owner use, group holds.
  blocked  Int @default(0)

  /// Deliberate oversell headroom, set by a Revenue Manager.
  overbookingAllowance Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, roomTypeId, stayDate], name: "inventory_day_unique_per_date")
  @@index([propertyId, stayDate])
  @@map("inventory_day")
}

/// Why a room, or some of a category, is withheld from sale for a date range.
enum RoomBlockReason {
  MAINTENANCE
  OWNER_USE
  TEMPORARY_CLOSURE
  DEEP_CLEAN
  RENOVATION
  OTHER
}

/// A block's lifecycle. Released rows are kept for the audit trail and drop
/// out of the overlap constraint, so the room becomes blockable again.
enum RoomBlockStatus {
  ACTIVE
  RELEASED
}

/// Capacity deliberately withheld from sale, for a date range.
///
/// ===========================================================================
/// Two shapes in one table, distinguished by `roomId`:
///
///   * `roomId` NULL  — a CATEGORY block of `rooms` units. "Hold back three
///     deluxe rooms next weekend." No physical room is named.
///   * `roomId` set   — a SPECIFIC room, and `rooms` is forced to 1 by
///     `room_block_specific_is_one_room`.
///
/// BOTH contribute to `inventory_day.blocked`, unconditionally: a category
/// block adds `rooms` per night, a specific-room block adds exactly 1. That is
/// what stops the two kinds double-counting — there is one accounting path, not
/// two. A specific-room block that did NOT consume category capacity would
/// leave a night sellable with no room to honour it.
///
/// `throughDate` is EXCLUSIVE, matching `reservation_room.departureDate` and
/// the `'[)'` ranges the exclusion constraints use. The API accepts an
/// inclusive date and converts once, in `room-block.policy.ts`.
///
/// WHAT THIS TABLE DOES NOT GUARANTEE. A specific-room block and a concurrent
/// room assignment can both commit: there is no cross-table constraint between
/// this table and `reservation_room`, and none is added in this increment.
/// Category capacity remains database-enforced by `inventory_day_not_oversold`
/// either way, so the failure mode is one guest in a room marked for work --
/// never an oversell, and never two guests in one room. See limitation F1.
/// ===========================================================================
model RoomBlock {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  /// Null for a category block. Set for one physical room.
  roomId String? @db.Uuid
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// Units withheld per night. Always 1 when `roomId` is set.
  rooms Int @default(1)

  /// Inclusive.
  fromDate    DateTime @db.Date
  /// EXCLUSIVE — the first night the block no longer covers.
  throughDate DateTime @db.Date

  reason RoomBlockReason
  note   String?

  status RoomBlockStatus @default(ACTIVE)

  createdByUserId  String    @db.Uuid
  releasedByUserId String?   @db.Uuid
  releasedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// The work order that took the room out of order (MA-01), if any.
  workOrders WorkOrder[]

  @@index([propertyId, fromDate])
  @@index([propertyId, roomId, fromDate])
  @@index([propertyId, roomTypeId, fromDate])
  @@index([propertyId, status, fromDate])
  @@map("room_block")
}

/// What kind of rate a plan is, for the operator's own organisation.
///
/// DESCRIPTIVE ONLY — nothing in the system branches on it. It exists so a
/// property with twenty plans can group them in a list, and that is all.
///
/// In particular it is **not** the distribution or company mechanism. A
/// corporate rate is a plan a company is *mapped to*, and an OTA rate is a
/// plan a channel is *mapped to*; both of those are relations that belong to
/// `companies` and the future `channels` module, not to an enum here. Were
/// this enum ever to acquire behaviour, that is the signal the mapping table
/// is the thing actually needed.
enum RatePlanKind {
  /// The property's own publicly sellable rate.
  STANDARD
  /// Negotiated. The company it belongs to is a future mapping, not this label.
  CORPORATE
  /// Room plus inclusions — breakfast, transfers. Inclusions are not modelled yet.
  PACKAGE
  /// Time-boxed offer. The window is expressed per date in F2, never here.
  PROMOTIONAL
  /// House use, staff, owner. Priced at or near nothing by intent.
  COMPLIMENTARY
}

/// A named, sellable price list.
///
/// ===========================================================================
/// WHY A PLAN AND NOT A COLUMN. `RoomType.baseRateMinor` is one number per
/// category, forever: a property cannot express a weekend price, a season or
/// a negotiated rate with it. A rate plan is the thing an operator names,
/// activates, and later prices per date.
///
/// `baseRateMinor` IS NOT TOUCHED OR MIGRATED BY THIS. It remains what the
/// booking path reads (`create-reservation.service.ts`), because integrating
/// plans into quoting and booking is F9 and is deliberately out of this
/// increment. Until F9 lands, a rate plan is configuration an operator can
/// author and nothing prices from it — which the screen says plainly rather
/// than implying a price is live.
///
/// SHAPE: THE PLAN, NOT THE CALENDAR. `defaultRateMinor` is the one nightly
/// figure a plan carries. Per-date pricing is a separate `rate_plan_day`
/// table in F2; this column is what a date with no such row will fall back
/// to, so F2 is purely additive on top of this.
///
/// MULTIPLE ROOM TYPES PER PLAN, through `RatePlanRoomType`. "Corporate BAR"
/// is one plan a hotel applies to Deluxe and Suite alike; a single
/// `roomTypeId` here would force two plans with one name, which the per-
/// property name uniqueness would then refuse. The join table is also the
/// shape a future `ChannelRatePlanMapping` needs, since an OTA maps a channel
/// rate code to a plan and its room types independently.
///
/// NOT DELETABLE, BY DESIGN. There is no delete endpoint. A plan that has ever
/// been quoted is history, and when F9 adds `reservation.ratePlanId` it will
/// be `onDelete: Restrict`, so deletion stays impossible rather than becoming
/// possible and then being taken away. `isActive` stops it being offered;
/// `archivedAt` is the terminal state and implies inactive (enforced by a
/// CHECK, one-directionally — an inactive plan is not necessarily archived).
/// ===========================================================================
model RatePlan {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Short operator-facing code, e.g. "BAR". Unique within the property, and
  /// never editable — it is the identity a future channel mapping points at.
  code String
  name String

  description String?

  kind RatePlanKind @default(STANDARD)

  /// ISO-4217, and always equal to `Property.currency` — the service refuses a
  /// mismatch. Stored rather than derived for the same reason
  /// `RoomType.currency` is: section 3.4 requires every monetary amount to
  /// travel with its own currency, so a rate read from this row is never
  /// ambiguous about what its minor units mean.
  currency String @db.Char(3)

  /// PRICING IS NOT HERE — F2 moved it to `RatePlanRoomType`.
  ///
  /// F1 carried `defaultRateMinor` and `baseOccupancy` on this model, which was
  /// wrong: one plan applies to several categories, and a Standard room is not
  /// priced like a Suite. Both columns now live on the assignment, one value
  /// per room type, and migration 20261110140000 copied the old plan-level
  /// figure onto every assignment before dropping them.
  ///
  /// A plan-level rate is deliberately NOT retained as a fallback. Two sources
  /// for one price is exactly the ambiguity this correction removes, and a
  /// stale plan-level number is the kind of second answer that eventually gets
  /// quoted to a guest.
  ///
  /// Offerable. Deactivating is reversible and loses nothing.
  isActive Boolean @default(true)

  /// Set once, terminally. Implies `isActive = false`.
  archivedAt DateTime? @db.Timestamptz(6)

  sortOrder Int @default(0)

  createdByUserId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  roomTypes    RatePlanRoomType[]
  pricingRules RatePricingRule[]
  promotions   PromotionRatePlan[]
  reservations Reservation[]

  /// Derived (linked) plan, AV-06: priced as the parent's nightly rate adjusted by
  /// derivationKind/Value. Null on a plan priced from its own calendar.
  parentRatePlanId String?    @db.Uuid
  parentRatePlan   RatePlan?  @relation("RatePlanDerivation", fields: [parentRatePlanId], references: [id], onDelete: Restrict)
  derivedPlans     RatePlan[] @relation("RatePlanDerivation")
  /// PERCENT (basis points, signed) or FIXED (minor units per night, signed).
  derivationKind   String?
  derivationValue  Int?

  @@unique([propertyId, code], name: "rate_plan_unique_code_per_property")
  @@unique([propertyId, name], name: "rate_plan_unique_name_per_property")
  /// Not redundant with the primary key: it is the pair a composite foreign
  /// key must reference, so `rate_plan_day` (F2) can be provably same-property
  /// the way `room_block` already is.
  @@unique([id, propertyId], name: "rate_plan_property_id_unique_pair")
  @@index([propertyId, isActive, sortOrder])
  @@map("rate_plan")
}

/// Which categories a rate plan applies to.
///
/// A join table rather than an array column: the composite foreign keys in the
/// migration make a cross-property link unrepresentable, which an array of
/// uuids could not do (section 3.2). `propertyId` is carried here for exactly
/// that reason, and because every index in this schema leads with it.
///
/// Both sides cascade on delete of the plan but RESTRICT on the room type: a
/// category still referenced by a plan must not vanish from under it, the same
/// rule `room_block` applies.
model RatePlanRoomType {
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ratePlanId String   @db.Uuid
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  /// THE DEFAULT NIGHTLY RATE FOR THIS CATEGORY UNDER THIS PLAN, in the
  /// currency's **minor unit** — paise for INR (section 3.4). Never a float.
  ///
  /// This is the fallback: a stay date with no `RatePlanDay` row is priced
  /// from here. One row per (plan, room type) is what makes "BAR = 1500 for
  /// Standard, 2500 for Deluxe, 4000 for Suite" expressible, and what makes
  /// editing one category's price provably unable to touch another's — they
  /// are different rows.
  defaultRateMinor Int

  /// THE NUMBER OF GUESTS `defaultRateMinor` INCLUDES.
  ///
  /// F1 recorded this so F4 would not have to guess, and F4 now reads it as
  /// the total included headcount — adults and children together, with
  /// `includedChildren` naming how many of them may be children. Its value is
  /// NOT changed by F4's migration.
  ///
  /// Bounded 1..20 by `rate_plan_room_type_base_occupancy_positive` (F2's
  /// migration). It must also not exceed the room type's `maxGuests`, which no
  /// CHECK can express because that lives on another table — the service
  /// enforces it.
  baseOccupancy Int @default(2)

  /**
   * -- F4: occupancy and extra-person pricing ---------------------------
   */

  /// Whether extra-guest charges apply at all for this assignment.
  ///
  /// DEFAULT FALSE, and that default is the whole migration-safety story: every
  /// rate plan created under F1, F2 or F3 keeps pricing exactly as it did,
  /// because a disabled configuration contributes nothing. An operator opts in
  /// per assignment.
  occupancyPricingEnabled Boolean @default(false)

  /// How many of `baseOccupancy` may be children at no extra charge.
  ///
  /// A SUBSET of base occupancy, not an addition to it — so a room whose base
  /// rate covers two guests, one of whom may be a child, is
  /// `baseOccupancy = 2, includedChildren = 1`, and the included adults are
  /// the remaining 1. Bounded `0 <= includedChildren <= baseOccupancy` by a
  /// CHECK, because "included children exceed the included headcount" is not a
  /// configuration anyone can act on.
  includedChildren Int @default(0)

  /// Fixed amount, or a percentage of the resolved nightly base rate.
  extraAdultChargeKind ExtraGuestChargeKind @default(FIXED)

  /// Integer minor units when `FIXED`; integer BASIS POINTS when `PERCENT`
  /// (100 = 1%, 10000 = 100%).
  ///
  /// One column for both, because the kind already says how to read it and a
  /// second nullable column would make "which one is authoritative" a question
  /// somebody has to answer at every read. Never a float: a percentage stored
  /// as 0.125 is a rounding argument waiting to happen (CLAUDE.md 3.4).
  extraAdultChargeValue Int @default(0)

  /// Children are priced separately from adults, because properties do not
  /// charge them alike — and several do not charge them at all.
  extraChildChargeKind  ExtraGuestChargeKind @default(FIXED)
  extraChildChargeValue Int                  @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  days            RatePlanDay[]
  rulePrices      RatePricingRulePrice[]
  restrictionDays RateRestrictionDay[]

  @@id([ratePlanId, roomTypeId])
  /// Not redundant with the primary key. It is the triple `rate_plan_day`'s
  /// composite foreign key references, and that one key proves two things at
  /// once: the assignment exists, and the day row belongs to the same property
  /// as the assignment. See the migration.
  @@unique([ratePlanId, roomTypeId, propertyId], name: "rate_plan_room_type_assignment_triple")
  @@index([propertyId, roomTypeId])
  @@index([propertyId, ratePlanId])
  @@map("rate_plan_room_type")
}

/// One date's price override for one room type under one rate plan.
///
/// ===========================================================================
/// THE WHOLE POINT: a row here exists only where the operator has deliberately
/// priced a night differently. Absence is meaningful — it means "use the
/// assignment's `defaultRateMinor`" — which is why clearing an override is a
/// DELETE and not a write of the default value. Storing the default on every
/// night would make a later change to the default silently fail to apply, and
/// would turn a 90-day calendar for 3 categories into 270 rows that all say
/// the same thing.
///
/// `stayDate` IS A CALENDAR DATE (`@db.Date`), not an instant. A nightly rate
/// belongs to the night the hotel calls that date; serialising it as a
/// timestamp shifts it by a day either side of midnight depending on the
/// reader's zone (section 3.3). It is never constructed from a browser clock.
///
/// NOT LINKED TO `RoomType` DIRECTLY. The relation is to `RatePlanRoomType`,
/// because a price for a category the plan does not apply to is not a thing
/// that should be representable. Removing an assignment cascades these away
/// with it, which is correct: the plan no longer prices that category at all.
///
/// `amountMinor` IS A NIGHTLY RATE, never a stay total. F9 will sum nights;
/// nothing here multiplies.
/// ===========================================================================
model RatePlanDay {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ratePlanId String @db.Uuid
  roomTypeId String @db.Uuid

  /// The assignment this override belongs to. A multi-field relation, so the
  /// pair cannot point at a plan and a category that are not linked.
  assignment RatePlanRoomType @relation(fields: [ratePlanId, roomTypeId], references: [ratePlanId, roomTypeId], onDelete: Cascade)

  /// The night being priced. A calendar date, never an instant.
  stayDate DateTime @db.Date

  /// Integer minor units, paired with the plan's currency. Zero is valid.
  amountMinor Int

  /// Who last wrote this night's price. No foreign key, consistent with
  /// `room_block.createdByUserId`: attribution must survive a staff member
  /// being removed.
  updatedByUserId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, ratePlanId, roomTypeId, stayDate], name: "rate_plan_day_unique_per_date")
  /// The calendar read: one plan, one category, a date window.
  @@index([propertyId, ratePlanId, roomTypeId, stayDate])
  /// Every index leads with `propertyId` (section 3.2).
  @@index([propertyId, stayDate])
  @@map("rate_plan_day")
}

/// Stay restrictions for one plan, one room type, one night (AV-07).
///
/// Checked at quote and booking time when a stay is priced from this plan:
/// minLos and closedToArrival are read from the ARRIVAL night,
/// closedToDeparture from the DEPARTURE date (a day the guest leaves, not a
/// night they stay). A night with no row is unrestricted. Rack-rate bookings
/// carry no plan and are not restricted.
model RateRestrictionDay {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ratePlanId String @db.Uuid
  roomTypeId String @db.Uuid

  assignment RatePlanRoomType @relation(fields: [ratePlanId, roomTypeId], references: [ratePlanId, roomTypeId], onDelete: Cascade)

  stayDate DateTime @db.Date

  /// Minimum nights for a stay ARRIVING on this date. Null = no minimum.
  minLos            Int?
  closedToArrival   Boolean @default(false)
  closedToDeparture Boolean @default(false)

  updatedByUserId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, ratePlanId, roomTypeId, stayDate], map: "rate_restriction_day_unique_per_date")
  @@map("rate_restriction_day")
}

/// How a promotion's discount is expressed (F5).
///
/// `FIXED_PER_NIGHT` is named for its scope, not merely its kind, and that is
/// deliberate: "₹500 off" is ambiguous between per night and per stay, and the
/// ambiguity is the sort that surfaces as a refund argument. Every other amount
/// in this pricing stack is nightly, so a fixed discount is nightly too — and
/// the enum says so, which leaves room for a `FIXED_PER_STAY` later without
/// reinterpreting any stored row.
enum PromotionDiscountKind {
  /// Integer basis points of the eligible nightly amount. 100 = 1%.
  PERCENT
  /// Integer minor units, deducted from each eligible night.
  FIXED_PER_NIGHT
}

/// How an extra-guest charge is expressed (F4).
///
/// `PERCENT` is relative to the RESOLVED nightly base rate for the night in
/// question — so it moves with an F2 override and with an F3 seasonal or
/// weekday rule, which is the point of expressing it as a percentage. `FIXED`
/// is an absolute amount per extra guest per night and never inherits the base
/// rate.
enum ExtraGuestChargeKind {
  FIXED
  PERCENT
}

/// What kind of date pattern a pricing rule matches (F3).
enum RatePricingRuleKind {
  /// An explicit, dated range — "Christmas 2026", 20 Dec to 10 Jan. Beats both
  /// recurring kinds, because a named date range is a more specific statement
  /// about those nights than "Saturdays are dearer".
  SEASONAL
  /// A named set of weekdays — "Friday and Saturday". Beats WEEKEND, because
  /// naming a day explicitly is more specific than deferring to the
  /// property's weekend definition.
  WEEKDAY
  /// Whatever the property calls its weekend (`PropertySettings.weekendDays`).
  /// The least specific rule, and the first to be overridden.
  WEEKEND
}

/// A recurring or seasonal pricing rule for one rate plan (F3).
///
/// ===========================================================================
/// ONE TABLE, THREE KINDS, and that is a deliberate choice over four tables.
/// A season and a weekday rule differ only in *how they decide whether a night
/// matches*; everything else — the plan, the per-room-type prices, priority,
/// enablement, naming, auditing, the CRUD surface — is identical. Four tables
/// would mean two of each of those, and two of anything is two things that
/// drift. The `kind` discriminator plus the CHECK constraints in migration
/// 20261110170000 make the illegal field combinations unrepresentable, which
/// is the same device `room_block_specific_is_one_room` uses.
///
/// WHAT DECIDES A MATCH, per kind:
///   * SEASONAL — `startDate` and `endDate`, both set, both INCLUSIVE.
///   * WEEKDAY  — `daysOfWeek`, non-empty, 0 = Sunday … 6 = Saturday.
///   * WEEKEND  — neither; the property's `weekendDays` decides.
///
/// DATES ARE INCLUSIVE AT BOTH ENDS, which differs from `room_block` and
/// `reservation_room` and is called out here because the difference is
/// deliberate. Those model *stays*, where the departure day is still sellable,
/// so they are half-open `[)`. A season is a set of nights an operator names:
/// "20 December through 10 January" means both of those nights. A half-open
/// season would silently drop its last night, which is the kind of off-by-one
/// that only shows up in a December revenue report.
///
/// A SEASON CROSSING NEW YEAR needs no special handling: `startDate`
/// 2026-12-20 with `endDate` 2027-01-10 is an ordinary range whose end is
/// after its start. What is NOT implemented is a *recurring annual* season
/// with no year component — see the migration's note.
///
/// PRIORITY BREAKS TIES WITHIN A KIND, higher wins. Equal priority on two
/// enabled rules of the same kind that overlap in dates AND share a room type
/// is an ambiguity, and it is REFUSED at write time rather than resolved by
/// row order. See `rate-pricing.policy.ts` for what happens if one exists
/// anyway.
///
/// PRICES LIVE IN THE CHILD TABLE, one per room type, exactly as
/// `RatePlanRoomType` holds the default. A rule that priced every category the
/// same would not express "Christmas: Standard 2,500, Suite 7,000", which is
/// the ordinary case.
/// ===========================================================================
model RatePricingRule {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ratePlanId String   @db.Uuid
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  kind RatePricingRuleKind

  /// Operator-facing. Unique within the plan, so an audit row naming
  /// "Christmas 2026" is unambiguous.
  name String

  /// SEASONAL only. Inclusive. Null for the recurring kinds.
  startDate DateTime? @db.Date
  /// SEASONAL only. INCLUSIVE — the last night the season covers.
  endDate   DateTime? @db.Date

  /// WEEKDAY only. 0 = Sunday … 6 = Saturday. Empty for the other kinds.
  daysOfWeek Int[]

  /// Higher wins among matching rules of the same kind. Ties are refused.
  priority Int @default(0)

  /// Disabled rules are kept, not deleted: a season an operator turns off for
  /// one year is usually wanted again the next.
  isEnabled Boolean @default(true)

  /// No foreign key, consistent with `room_block.createdByUserId` and
  /// `rate_plan_day.updatedByUserId`: attribution must survive a staff member
  /// being removed.
  createdByUserId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  prices RatePricingRulePrice[]

  @@unique([propertyId, ratePlanId, name], name: "rate_pricing_rule_unique_name_per_plan")
  /// The triple `rate_pricing_rule_price` references, so a price row is
  /// provably attached to a rule of the same plan and property — the device
  /// `rate_plan_room_type_assignment_triple` provides for `rate_plan_day`.
  @@unique([id, ratePlanId, propertyId], name: "rate_pricing_rule_plan_triple")
  /// The resolver's read: one plan's enabled rules, ordered by precedence.
  @@index([propertyId, ratePlanId, isEnabled, kind, priority])
  /// Seasonal date-window scans.
  @@index([propertyId, ratePlanId, startDate, endDate])
  @@map("rate_pricing_rule")
}

/// One room type's price under one pricing rule (F3).
///
/// `ratePlanId` is carried here deliberately, denormalised from the rule, so
/// that TWO composite foreign keys can hold at once (see the migration):
/// one tying the row to a rule of that plan, and one tying it to a
/// `RatePlanRoomType` assignment of that same plan. Together they make it
/// impossible to price a category the plan does not even apply to — the
/// guarantee `rate_plan_day` already has, reached the same way.
model RatePricingRulePrice {
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  ruleId String          @db.Uuid
  rule   RatePricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  /// Denormalised from the rule; kept honest by a composite foreign key.
  ratePlanId String @db.Uuid
  roomTypeId String @db.Uuid

  /// The plan/room-type assignment this price belongs to.
  ///
  /// A multi-field relation, exactly as `RatePlanDay.assignment` is, so the
  /// pair cannot point at a plan and a category that are not linked — and so
  /// a read can reach the room type's code and name without a second query.
  /// It mirrors the SQL composite key `rate_pricing_rule_price_assignment`.
  assignment RatePlanRoomType @relation(fields: [ratePlanId, roomTypeId], references: [ratePlanId, roomTypeId], onDelete: Cascade)

  /// Integer minor units, paired with the plan's currency. Zero is valid — a
  /// complimentary season is a real configuration. Negative is refused.
  amountMinor Int

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@id([ruleId, roomTypeId])
  @@index([propertyId, roomTypeId])
  @@index([propertyId, ruleId])
  @@map("rate_pricing_rule_price")
}

/// A discount an operator configures and an eligible stay can receive (F5).
///
/// ===========================================================================
/// WHERE F5 SITS IN THE STACK. The nightly amount is already decided by the
/// time a promotion is considered:
///
///   1. F1/F2/F3 resolve the BASE rate — override → seasonal → weekday →
///      weekend → assignment default.
///   2. F4 adds extra-adult and extra-child charges.
///   3. F5 discounts the result.
///
/// So a promotion never overwrites a base rate or an occupancy configuration;
/// it reduces the occupancy-adjusted nightly amount. The eligible amount is
/// that adjusted amount, which is why a percentage promotion automatically
/// discounts the extra-person charges too.
///
/// PROMOTIONS DO NOT STACK. At most one applies to a night, chosen by the
/// highest `priority`. A tie between two active promotions whose applicability
/// overlaps is refused at WRITE time, because the resolver must never pick by
/// row order — the same discipline F3's pricing rules follow.
///
/// APPLICABILITY IS EXPLICIT, NEVER INFERRED FROM AN EMPTY SET. This is the
/// trap the scope names: an empty relation must not mean "all" in one place and
/// "none" in another. So there are two booleans. `appliesToAllRatePlans = true`
/// means every plan and the join table is ignored; `false` means exactly the
/// plans listed, and an empty list means NOTHING is eligible. The service
/// refuses to create a promotion that can never apply, so the degenerate state
/// is unreachable through the API rather than merely unlikely.
///
/// DATES ARE CALENDAR DATES, INCLUSIVE AT BOTH ENDS, and `NULL` means
/// unbounded on that side. Two independent windows: `stay*` bounds which
/// NIGHTS qualify, `book*` bounds WHEN the booking may be made. A promotion
/// may have either, both or neither.
///
/// REDEMPTION IS CONFIGURED HERE AND CONSUMED BY F9. `redeemedCount` ships at
/// zero with no writer in F5: previewing never touches it. See
/// `PromotionRedemption` for the atomic contract F9 must use.
/// ===========================================================================
model Promotion {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Operator-facing. Unique within the property, so an audit row naming
  /// "Monsoon 20% off" is unambiguous.
  name        String
  description String?

  discountKind  PromotionDiscountKind
  /// Basis points when `PERCENT` (capped at 10000 = 100%); integer minor units
  /// when `FIXED_PER_NIGHT`. One column, because the kind says how to read it.
  discountValue Int

  /// Higher wins when two promotions both qualify. Ties that overlap in
  /// applicability are refused at write time.
  priority Int @default(0)

  isActive Boolean @default(true)

  /// Which NIGHTS qualify. Inclusive; null means unbounded that side.
  stayFromDate    DateTime? @db.Date
  stayThroughDate DateTime? @db.Date

  /// WHEN the booking may be made. Inclusive; null means unbounded that side.
  bookFromDate    DateTime? @db.Date
  bookThroughDate DateTime? @db.Date

  /// Stay-length eligibility conditions. NOT the F6 restriction engine — these
  /// gate this promotion only and restrict nothing else about the stay.
  minNights Int?
  maxNights Int?

  /// The stay's pre-discount, pre-tax total must reach this to qualify.
  minEligibleAmountMinor Int?

  /// See the model comment: explicit, never inferred from an empty join.
  appliesToAllRatePlans Boolean @default(false)
  appliesToAllRoomTypes Boolean @default(false)

  /// Null means unlimited. Enforced by F9, not by F5.
  maxRedemptions Int?
  /// Ships at zero. F5 has no writer for it; F9 consumes it atomically.
  redeemedCount  Int  @default(0)

  createdByUserId String  @db.Uuid
  updatedByUserId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  ratePlans   PromotionRatePlan[]
  roomTypes   PromotionRoomType[]
  codes       PromoCode[]
  redemptions PromotionRedemption[]

  @@unique([propertyId, name], name: "promotion_unique_name_per_property")
  /// The pair every child table's composite foreign key references, so a child
  /// row is provably same-property — the device `rate_plan_property_id_unique_pair`
  /// provides for the rate tables.
  @@unique([id, propertyId], name: "promotion_property_id_unique_pair")
  /// The eligibility read: one property's active promotions over a date window.
  @@index([propertyId, isActive, priority])
  @@index([propertyId, stayFromDate, stayThroughDate])
  @@map("promotion")
}

/// Which rate plans a promotion applies to, when it is not "all".
model PromotionRatePlan {
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  promotionId String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  /// RESTRICT, not cascade: a rate plan still named by a promotion must not
  /// vanish from under it. Rate plans are archived rather than deleted anyway,
  /// so this should never fire — it is here so it cannot.
  ratePlanId String   @db.Uuid
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([promotionId, ratePlanId])
  @@index([propertyId, ratePlanId])
  @@index([propertyId, promotionId])
  @@map("promotion_rate_plan")
}

/// Which room types a promotion applies to, when it is not "all".
model PromotionRoomType {
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  promotionId String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([promotionId, roomTypeId])
  @@index([propertyId, roomTypeId])
  @@index([propertyId, promotionId])
  @@map("promotion_room_type")
}

/// A redeemable code attached to a promotion (F5).
///
/// ===========================================================================
/// A CODE IS A REDEMPTION MECHANISM, NOT A SECOND DISCOUNT ENGINE. It carries
/// no discount of its own: eligibility and the amount come from the promotion
/// it belongs to. A promotion may have several codes, or none — a promotion
/// with no code applies automatically to any eligible stay.
///
/// TWO COLUMNS FOR ONE CODE, deliberately. `code` is what the operator typed,
/// preserved for display so "SUMMER24" does not come back as "summer24".
/// `codeNormalized` is upper-cased and trimmed and is the ONLY thing matched
/// or made unique — which is what makes lookup case-insensitive without
/// relying on a case-insensitive collation or a functional index whose
/// behaviour varies with the database's locale.
/// ===========================================================================
model PromoCode {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  promotionId String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  /// As entered, for display only. Never matched against.
  code           String
  /// Upper-cased and trimmed. The matched and unique form.
  codeNormalized String

  isActive  Boolean   @default(true)
  /// Inclusive — the last calendar date the code may be used. Null = no expiry.
  expiresOn DateTime? @db.Date

  /// Null means unlimited. Enforced by F9, not by F5.
  maxRedemptions Int?
  redeemedCount  Int  @default(0)

  createdByUserId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  redemptions PromotionRedemption[]

  @@unique([propertyId, codeNormalized], name: "promo_code_unique_per_property")
  @@unique([id, propertyId], name: "promo_code_property_id_unique_pair")
  @@index([propertyId, promotionId])
  @@map("promo_code")
}

/// One consumption of a promotion by one reservation.
///
/// ===========================================================================
/// SCAFFOLDING FOR F9. It ships EMPTY and F5 contains no writer for it: a
/// preview never inserts a row and never moves a counter. It exists now
/// because a redemption counter with no record of what consumed it is
/// unauditable, and because the shape determines whether F9 can consume
/// atomically at all.
///
/// THE ATOMIC CONSUMPTION CONTRACT F9 MUST USE. Inside the reservation's own
/// transaction, in this order:
///
///   1. INSERT a row here. `@@unique([propertyId, reservationId])` makes it the
///      idempotency key: a retried booking cannot redeem twice, and the second
///      insert fails with P2002 rather than silently double-counting.
///   2. Increment the counter CONDITIONALLY, in one statement:
///
///        UPDATE promotion SET "redeemedCount" = "redeemedCount" + 1
///         WHERE id = $1 AND "propertyId" = $2
///           AND ("maxRedemptions" IS NULL OR "redeemedCount" < "maxRedemptions")
///
///      Zero rows affected means exhausted, and the transaction rolls back.
///      This is NOT read-then-increment: the bound is re-tested inside the same
///      statement that writes, so two concurrent bookings cannot both pass a
///      check and both increment. The CHECK constraint
///      `promotion_redeemed_within_limit` is the backstop if a future writer
///      forgets the predicate.
///   3. The same for `promo_code` when a code was used.
///
/// Nothing in F5 performs any of this. It is written down so F9 does not have
/// to rediscover it, and so nobody ships a check-then-increment and calls it
/// safe.
/// ===========================================================================
model PromotionRedemption {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  promotionId String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  /// Null when the promotion applied automatically, with no code.
  promoCodeId String?    @db.Uuid
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  /// No Prisma relation, and the composite foreign key is in the migration —
  /// the established convention for a same-property key onto a non-primary
  /// key, which Prisma cannot express. Declaring a relation here would also
  /// mean editing the `Reservation` model, which this scope does not do.
  reservationId String @db.Uuid

  /// What was actually deducted, in minor units. Recorded rather than
  /// recomputed, because the configuration may change after the stay.
  discountAppliedMinor Int

  redeemedAt DateTime @default(now()) @db.Timestamptz(6)

  /// The idempotency key of the contract above: one promotion per reservation.
  @@unique([propertyId, reservationId], name: "promotion_redemption_unique_per_reservation")
  @@index([propertyId, promotionId])
  @@index([propertyId, promoCodeId])
  @@map("promotion_redemption")
}

/// A booking.
///
/// Guest details are embedded rather than pointing at a `Guest` profile table,
/// which does not exist yet. That is a known provisional shape: the `frontdesk`
/// module in CLAUDE.md section 2 owns guest profiles, and these columns become
/// a foreign key when it lands. They are kept minimal so that migration stays
/// additive — and none of them is ever logged, because guest PII must not reach
/// a log line (section 5).
model Reservation {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// What the guest quotes on the phone. Unique per property, not globally — a
  /// unique constraint omitting propertyId would couple unrelated hotels
  /// (CLAUDE.md section 3.2).
  confirmationCode String

  status ReservationStatus @default(CONFIRMED)
  source BookingSource     @default(FRONT_DESK)

  /// Half-open: arrival inclusive, departure exclusive.
  arrivalDate   DateTime @db.Date
  departureDate DateTime @db.Date

  adults   Int @default(1)
  children Int @default(0)
  /// Under 2s. Counted separately because they do not consume occupancy for
  /// rate or capacity purposes, so folding them into `children` would inflate
  /// both the occupancy figure and the price.
  infants  Int @default(0)

  guestFirstName String
  guestLastName  String
  guestEmail     String?
  guestPhone     String?

  /// The channel's own reservation id, for an OTA booking.
  ///
  /// Required by the inbound sync contract, not just by search: CLAUDE.md
  /// section 5 makes ingestion idempotent *on the channel's reservation id*,
  /// and that is impossible without storing it. The unique index below is what
  /// actually enforces it — an index alone would let a retried webhook create
  /// a second copy of the same booking. Null for anything sold directly.
  otaBookingId String?

  /// Government photo ID, where one was recorded at check-in.
  ///
  /// ===========================================================================
  /// Guest PII of the most sensitive kind — Aadhaar, passport, PAN, licence.
  /// Indian hotels are legally required to record it, so the column has to
  /// exist, and the front desk searches by its last digits when a guest
  /// presents a card. That forces a plaintext column: a one-way hash cannot
  /// answer a partial match.
  ///
  /// Two rules therefore apply wherever it is touched, both enforced in the
  /// API rather than here:
  ///   * It is NEVER returned whole. The search response carries a masked form
  ///     (`XXXX-XXXX-1234`) plus the last four, never the full value.
  ///   * It is NEVER logged, not in a query log, not in an error context, and
  ///     not in a channel payload dump (CLAUDE.md section 5).
  ///
  /// When a `guests` module lands with real guest profiles this moves there,
  /// with column-level encryption and an access audit trail.
  /// ===========================================================================
  govtIdNumber String?

  /// Which document `govtIdNumber` is. Null when no ID was recorded.
  govtIdType GovtIdType?

  mealPlan MealPlan @default(EP)

  /// Integer minor units, paired with its currency (section 3.4). The folio is
  /// the authority on what is actually owed; this is the agreed stay total.
  totalAmountMinor Int
  currency         String @db.Char(3)

  /// Settled so far, in minor units.
  ///
  /// Provisional, and knowingly against the grain of section 3.4: a balance
  /// must be *derived* by summing immutable folio lines, never cached. There
  /// is no Folio table yet, so this is the minimum that lets the front desk
  /// see what is outstanding. Note what is deliberately NOT here: a
  /// `balanceAmount` column. The balance is computed as
  /// `totalAmountMinor - paidAmountMinor` at the API boundary, so there is no
  /// third number able to disagree with the two it comes from. When `folios`
  /// lands, both of these become derived and this column is dropped.
  paidAmountMinor Int @default(0)

  /// Who checked the guest in, and with what.
  ///
  /// `checkedInAt` already existed for the hourly calendar view; these record
  /// the rest of the desk transaction. `checkedInBy` is a staff user id rather
  /// than a name, so a renamed account does not rewrite history.
  checkedInBy            String? @db.Uuid
  keyCardsIssued         Int?
  registrationCardSigned Boolean @default(false)

  /// How the desk payment was taken, and any reference for it.
  ///
  /// Provisional in the same way `paidAmountMinor` is: a payment is properly a
  /// folio transaction with its own date, actor and reversal trail, and there
  /// is no Folio table. A cheque number recorded nowhere is a cheque nobody
  /// can chase, so these hold it until `FolioPayment` exists to own it.
  paymentMethod PaymentMethod?
  paymentRemark String?

  /// Whether this stay was quoted free of tax.
  ///
  /// Persisted because its absence is indistinguishable from the thing it
  /// must be distinguished from. 881 of 882 reservations record
  /// `taxAmountMinor = 0`, almost all because they predate tax being computed
  /// at all — so the folio derives the split from the property's configured
  /// rate. Without this flag a genuinely exempt booking (a diplomatic stay, an
  /// SEZ guest) would be taxed by that same derivation, and the first anyone
  /// would know is the invoice.
  isTaxExempt Boolean @default(false)

  /// Tax inside `totalAmountMinor`, in minor units.
  ///
  /// Provisional, and knowingly against the grain of section 3.4: tax belongs
  /// on its own folio line carrying a reference to the charge it derives from,
  /// never folded into a gross total. There is no Folio table yet, so the
  /// alternative is to compute tax at booking and then lose it — which would
  /// make every stored total un-reconcilable. Kept beside `paidAmountMinor`,
  /// which is provisional for exactly the same reason, and dropped the moment
  /// `folios` lands and real tax lines exist.
  taxAmountMinor Int @default(0)

  /// True while a self-service link (check-in, payment) is live for the guest.
  isMagicLinkActive Boolean @default(false)

  /// When the guest physically arrived and departed.
  ///
  /// Distinct from `arrivalDate` / `departureDate`, which are the *booked*
  /// calendar dates. These are instants, and they are what the hourly Day view
  /// of the reservation calendar positions a block against — without them the
  /// best it could do is assume everyone arrives at the property's standard
  /// desk time, which is exactly the guess an hourly view exists to replace.
  ///
  /// Null until the front desk checks the guest in or out, so a booking that
  /// has not arrived yet legitimately has neither. Written by the `frontdesk`
  /// module when it lands; until then only the seed populates them.
  checkedInAt  DateTime? @db.Timestamptz(6)
  checkedOutAt DateTime? @db.Timestamptz(6)

  /// When the booking was cancelled, for the master report's cancel-date
  /// column. An instant rather than a date: a cancellation inside the free
  /// window and one an hour later attract different retention, and only a
  /// timestamp can tell them apart. Guarded so it is set only on a cancelled
  /// or no-show booking.
  cancelledAt DateTime? @db.Timestamptz(6)

  /**
   * -- Commercial attribution -------------------------------------------
   */

  /// The operator's own reference, distinct from `confirmationCode`. A group
  /// booking taken against a tour operator's paperwork carries their number
  /// here so the two can be reconciled without overloading ours.
  bookingReferenceId String?

  /// Market segment, e.g. "Corporate", "OTA", "Leisure", "Group". Free text:
  /// segmentation is a commercial taxonomy that changes without a migration,
  /// and nothing in the domain branches on it.
  segment String?

  /// Front-desk flags.
  ///
  /// `scantyBaggage` marks a guest who arrived with little or no luggage,
  /// which most properties treat as a credit-risk signal worth recording at
  /// check-in. `isComplimentary` marks a stay given free of charge, and the
  /// remark is why — authorised by whom, against which budget. The remark is
  /// constrained to complimentary stays, because a reason for something that
  /// did not happen is a field nobody can interpret.
  scantyBaggage        Boolean @default(false)
  isComplimentary      Boolean @default(false)
  complimentaryRemarks String?

  /**
   * -- OTA settlement ----------------------------------------------------
   */

  /// What the channel actually settles, in integer minor units.
  ///
  /// ===========================================================================
  /// Four figures, not one derived from the others.
  ///
  /// `otaNetAmountMinor` is what the OTA *remits*, which is not reliably
  /// `total - commission - tax`: channels withhold differently, settle in
  /// batches, and adjust for cancellations after the fact. Storing the
  /// remittance separately is what lets a finance team reconcile a bank credit
  /// against the bookings it covers — deriving it would make every discrepancy
  /// invisible.
  ///
  /// `otaPrepaidAmountMinor` is the part the guest already paid the channel,
  /// which the property never touches and must not count as its own takings.
  ///
  /// Zero on a direct booking, which is the honest value rather than null: a
  /// walk-in has no OTA commission, it does not have an unknown one. Written
  /// by the `channels` module when it lands; until then only the seed sets
  /// them (CLAUDE.md section 2).
  /// ===========================================================================
  otaPrepaidAmountMinor Int @default(0)
  otaCommissionMinor    Int @default(0)
  otaTaxMinor           Int @default(0)
  otaNetAmountMinor     Int @default(0)

  /**
   * -- Promotions --------------------------------------------------------
   */

  /// The discount a promotion took off this booking, and the code that did it.
  /// Integer minor units like every other amount. A promotions module would own
  /// the catalogue of codes; this records which one was applied and for how
  /// much, which is what a report has to show either way.
  promoAmountMinor  Int     @default(0)
  appliedCouponCode String?

  /**
   * -- Deposits ----------------------------------------------------------
   */

  /// A refundable security deposit held against the stay.
  ///
  /// Deliberately not a folio payment line. A deposit is not revenue and is
  /// not a settlement of the bill — it is the property holding the guest's
  /// money, returnable at checkout. Counting it as a payment would understate
  /// the balance due and overstate the day's takings, which is why the folio's
  /// own deposits tab is still unbuilt rather than approximated.
  depositMinor Int @default(0)

  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// The company billed for this stay, where it is a corporate booking.
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// The rate plan the stay was priced from. Null for stays priced from the room type rack rate.
  ratePlanId String?   @db.Uuid
  ratePlan   RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)

  rooms         ReservationRoom[]
  guests        ReservationGuest[]
  folio         Folio?
  invoices      Invoice[]
  internalNotes ReservationNote[]
  companyLedger CompanyLedgerEntry[]
  paymentLinks  PaymentLink[]
  /// What each night was sold for. Written once at booking; never repriced.
  pricedNights  ReservationNight[]

  @@unique([propertyId, confirmationCode], name: "reservation_unique_code_per_property")
  /// Idempotency for inbound OTA ingestion (CLAUDE.md section 5). Postgres
  /// treats NULLs as distinct in a unique index, so every direct booking
  /// coexists freely; only two bookings claiming the *same* channel reference
  /// collide, which is exactly the retry case this prevents.
  @@unique([propertyId, otaBookingId], name: "reservation_unique_ota_id_per_property")
  @@index([propertyId, arrivalDate])
  @@index([propertyId, departureDate])
  @@index([propertyId, status])
  /// Supports the dashboard's "new bookings today" count, which filters on
  /// when the booking was *made* rather than when the stay falls.
  @@index([propertyId, createdAt])
  @@index([propertyId, isMagicLinkActive])
  /// Supports the booking-source report, which groups by source across a date
  /// window. Without it that grouping scans every reservation in the portfolio
  /// on each dashboard load.
  @@index([propertyId, source, arrivalDate])
  /// Omnibar search paths. Each leads with propertyId, as every operational
  /// index must (CLAUDE.md section 3.2), so a search can never scan another
  /// hotel's rows even before the tenant filter is applied.
  ///
  /// These serve prefix and exact matches. A mid-string `contains` still scans,
  /// which is acceptable at this scale — ~900 reservations per property, and
  /// the planner has propertyId to narrow by first. A pg_trgm GIN index is the
  /// answer if that ever stops being true; it is not worth the write cost for
  /// ten hotels.
  @@index([propertyId, guestPhone])
  @@index([propertyId, govtIdNumber])
  @@index([propertyId, guestLastName])
  @@index([propertyId, guestFirstName])
  @@index([propertyId, ratePlanId])
  @@map("reservation")
}

/// One night of a reservation, as priced at booking (rates increment F9).
///
/// The source of truth for what a night costs once sold: check-in posts the
/// arrival night from here, and night audit step 3 will post the rest. Written
/// in the booking transaction and never repriced, so a rate change after the
/// booking cannot alter what the guest agreed to (CLAUDE.md section 3.4).
/// Stays booked before this table existed have no rows; their nights are still
/// derived from the reservation totals.
model ReservationNight {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  stayDate DateTime @db.Date

  /// The room tariff for the night before tax, in minor units.
  rateMinor      Int
  /// Tax on that tariff, rounded once, in minor units.
  taxMinor       Int
  /// The GST band the night fell in. A rate, not money, so Decimal is permitted.
  taxRatePercent Decimal @db.Decimal(5, 2)
  currency       String  @db.Char(3)

  /// Which tier priced it: DATE_OVERRIDE, SEASONAL, WEEKDAY, WEEKEND, DEFAULT,
  /// RACK (room type base rate) or MANUAL (operator override / target total).
  rateSource String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([propertyId, reservationId, stayDate], name: "reservation_night_one_per_date")
  @@index([propertyId, stayDate])
  /// PF-03: a relation load fetches children by the parent id alone; RLS's
  /// `bypass OR propertyId = …` filter can never become an index condition,
  /// so without this the propertyId-led indexes are walked end to end.
  @@index([reservationId])
  @@map("reservation_night")
}

/// One room of one reservation, for one date range.
///
/// A reservation may hold several rooms, each assignable to a different
/// physical room — or to none yet. `roomId` is nullable for that reason, and it
/// interacts with the exclusion constraint usefully: NULLs are not equal to one
/// another in GiST, so any number of unassigned rows coexist, and the
/// constraint starts biting the moment a number is given.
///
/// `status` is duplicated from the parent reservation deliberately. The partial
/// exclusion constraint needs the status in its own WHERE clause, and a
/// constraint cannot read another table. Keeping the two in step is the
/// aggregate's job (CLAUDE.md section 3.4).
model ReservationRoom {
  id String @id @default(uuid()) @db.Uuid

  propertyId String @db.Uuid

  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  roomTypeId String   @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  /// Null until the front desk assigns a number.
  roomId String? @db.Uuid
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  arrivalDate   DateTime @db.Date
  departureDate DateTime @db.Date

  status ReservationStatus @default(CONFIRMED)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([propertyId, roomId, arrivalDate])
  @@index([propertyId, arrivalDate])
  @@index([reservationId])
  @@index([roomTypeId])
  @@map("reservation_room")
}

/// Everyone staying on one reservation.
///
/// ===========================================================================
/// `ordinal` 1 is the booker, whose name, phone and email are ALSO on
/// `reservation` — those columns are what search, the timeline and every
/// report read, and they are indexed for it. The copy is maintained in the
/// same transaction as this row, which is the only way two representations of
/// one fact stay honest (CLAUDE.md section 3.4 takes the same position on
/// materialised balances).
///
/// This table is not a guest *profile*. It is the guest list for one stay:
/// there is no identity shared across reservations, no stay history, no
/// merging of duplicates. That is the `frontdesk` module's work, and when it
/// lands this table gains a nullable `guestId` pointing at it rather than
/// being replaced.
/// ===========================================================================
model ReservationGuest {
  id String @id @default(uuid()) @db.Uuid

  propertyId String @db.Uuid

  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  /// 1 is the booker. 2..n are the accompanying adults.
  ordinal Int

  firstName String
  lastName  String  @default("")
  email     String?
  phone     String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  countryCode  String? @db.Char(2)

  gender      Gender?
  dateOfBirth DateTime? @db.Date
  nationality String?
  occupation  String?

  govtIdType   GovtIdType?
  govtIdNumber String?

  specialRequest String?

  /// GP-02: the reusable profile a clerk linked this row to. Never set
  /// automatically; null for a guest nobody has linked.
  guestProfileId String?       @db.Uuid
  guestProfile   GuestProfile? @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// One row per position per reservation, and scoped by property like every
  /// other operational unique constraint (section 3.2).
  @@unique([propertyId, reservationId, ordinal], name: "reservation_guest_unique_ordinal")
  @@index([propertyId, reservationId])
  @@index([propertyId, guestProfileId])
  /// PF-03: a relation load fetches children by the parent id alone; RLS's
  /// `bypass OR propertyId = …` filter can never become an index condition,
  /// so without this the propertyId-led indexes are walked end to end.
  @@index([reservationId])
  @@map("reservation_guest")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// A corporate account billed for stays.
///
/// ===========================================================================
/// `gstin` is unique **per property**, not globally. A global unique on it
/// would be a cross-tenant coupling bug: two hotels in this portfolio booking
/// the same corporate client — the ordinary case, not the exotic one — would
/// collide, and the second would be unable to create its own record
/// (CLAUDE.md section 3.2).
///
/// The trade is that the same company exists as one row per property. That is
/// correct here: billing address, contact and credit terms are negotiated per
/// hotel, and a shared row would force one hotel's edit onto another's
/// invoices.
/// ===========================================================================
model Company {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Legal name as it must appear on the tax invoice.
  legalName String
  /// Trading name, where it differs.
  tradeName String?

  /// 15 characters, validated by structure and checksum before it is stored.
  gstin String @db.Char(15)

  /// Provenance of `legalName`. See `GstinVerification`.
  gstinVerification GstinVerification @default(UNVERIFIED)
  /// Which provider answered, and when. Null when nobody was asked.
  gstinProvider     String?
  gstinVerifiedAt   DateTime?         @db.Timestamptz(6)

  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?
  email        String?
  phone        String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  reservations Reservation[]
  ledger       CompanyLedgerEntry[]

  @@unique([propertyId, gstin], name: "company_unique_gstin_per_property")
  @@index([propertyId, legalName])
  @@map("company")
}

/// An internal note somebody wrote against a reservation.
///
/// ===========================================================================
/// Separate rows, not the free-text `Reservation.notes` field.
///
/// `Reservation.notes` is one string with no author and no timestamp, which is
/// fine for "late arrival, flight AI-302" captured at booking and useless for
/// a running log: two clerks editing it overwrite each other, and nothing
/// records who said what. The drawer needs a list with an author and a time,
/// so notes become rows.
///
/// The booking-time field stays where it is and is shown as the booking note.
/// Migrating it into this table would invent an author and a timestamp for
/// text that has neither.
///
/// Append-only by contract, like `FolioLine`: an internal note is part of how
/// a property explains a decision later, and silently editable history is
/// worth less than none.
/// ===========================================================================
model ReservationNote {
  id String @id @default(uuid()) @db.Uuid

  propertyId String @db.Uuid

  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  /// Staff member who wrote it. Null for a note the system generated.
  authorUserId String? @db.Uuid
  /// Their name as it was when they wrote it, so a renamed or departed
  /// account does not blank the byline on an old note.
  authorName   String

  body String

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId, reservationId, createdAt])
  @@map("reservation_note")
}

/// A property's operational configuration.
///
/// ===========================================================================
/// One row per property, holding what the front desk and the night audit need.
///
/// Separate from `Property` because these are settings an operator edits,
/// while `Property` is identity — the name, code and address that other
/// records point at. Mixing them means every settings change rewrites a row
/// that half the system joins against.
///
/// `checkInTime` and `checkOutTime` stay on `Property` as well, for now: the
/// calendar, the drawer and the folio all read them from there, and moving
/// them in one change would touch every one of those paths at once. This row
/// is the place they will move to, and `PropertyConfigService` already reads
/// through to it so the eventual move is a one-line change rather than a
/// migration of every caller.
/// ===========================================================================
model PropertySettings {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @unique @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Wall-clock times in the property's own timezone, `HH:MM`.
  standardCheckInTime  String @default("14:00")
  standardCheckOutTime String @default("11:00")

  /// Minutes between a departure and the next arrival, for housekeeping.
  turnaroundGraceMins Int @default(60)

  /// Prefixes for human-facing identifiers.
  bookingPrefix String @default("SFBOOKING_")
  folioPrefix   String @default("FOL_")
  invoicePrefix String @default("INV_")

  /// The hotel's own GSTIN, printed as the supplier on its invoices (FO-14).
  /// Null until configured; an invoice issued without it is titled "Invoice",
  /// not "Tax Invoice", because a tax invoice must name the registered supplier.
  gstin String? @db.Char(15)

  /// How long an unconfirmed hold survives before inventory is released.
  autoHoldReleaseHours Int @default(4)

  /// When the night audit is scheduled, in the property's timezone
  /// (CLAUDE.md section 3.3 — ten properties, ten independent schedules).
  nightAuditHour String @default("02:00")

  /// Which days this property treats as its weekend, as ISO-ish day numbers
  /// where 0 is Sunday and 6 is Saturday.
  ///
  /// ===========================================================================
  /// INTRODUCED BY F3, because weekend pricing cannot be built on a guess. Two
  /// places in this repository already hardcode Saturday and Sunday
  /// (`timeline.service.ts`), and that is wrong for much of the world: a Goa
  /// resort's weekend is Saturday and Sunday, a Gulf property's is Friday and
  /// Saturday, and a city hotel selling to business travellers may price
  /// Sunday to Thursday as its peak. A WEEKEND pricing rule asks "is this
  /// night a weekend night", and only the property can answer.
  ///
  /// Default `[0, 6]` — Sunday and Saturday — so every existing property keeps
  /// the behaviour the hardcoded checks already gave it. The default is safe
  /// rather than clever.
  ///
  /// An EMPTY array is legal and means "this property has no weekend", which
  /// makes every WEEKEND rule match nothing. That is a real configuration for
  /// a property that prices only by named weekdays, and it is better than
  /// forbidding it and forcing a fake weekend.
  ///
  /// The weekday of a stay date needs no timezone: `2026-12-20` is a Sunday
  /// everywhere. What matters is never converting the date through a local
  /// `Date` on the way to asking (CLAUDE.md section 3.3) — see
  /// `rate-pricing.policy.ts`.
  /// ===========================================================================
  weekendDays Int[] @default([0, 6])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("property_settings")
}

/// A GST slab: a tariff band and the rate that applies inside it.
///
/// ===========================================================================
/// Tax policy belongs in data, not in a constant.
///
/// Indian GST on room tariff is banded — the rate depends on what the room
/// costs per night, and the bands move when the Council says so. The platform
/// previously carried a single `property.taxRatePercent`, which forced every
/// room in a property onto one rate and made a rate change a code change.
///
/// `cgstRatePercent` and `sgstRatePercent` are stored rather than derived by
/// halving. Halving is right for an intra-state supply and wrong for an
/// inter-state one (which is IGST and is not split at all), and a Council
/// notification can in principle split a slab unevenly. Storing both means an
/// invoice prints what the slab says rather than what the code assumed.
///
/// `Decimal` here is correct and is not a money column: these are *rates*,
/// which section 3.4 explicitly permits as Decimal. The tariff bounds are
/// integer minor units like every other amount in this schema.
/// ===========================================================================
model PropertyTaxSlab {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  slabName String

  /// Inclusive lower bound of the nightly tariff, in minor units.
  minTariffMinor Int
  /// Exclusive upper bound, or null for the open-ended top band.
  maxTariffMinor Int?

  taxRatePercent  Decimal @db.Decimal(5, 2)
  cgstRatePercent Decimal @db.Decimal(5, 2)
  sgstRatePercent Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// Two slabs of one property must not claim the same floor: which applies
  /// would then depend on row order, and a tariff would be taxed differently
  /// depending on how the planner happened to sort. Declared here rather than
  /// only in SQL so Prisma can use it as an upsert key — a hand-written index
  /// the client cannot see is an index the seed cannot upsert against.
  @@unique([propertyId, minTariffMinor], map: "property_tax_slab_unique_floor_per_property")
  @@map("property_tax_slab")
}

/// A photograph of the property.
model PropertyMedia {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  category MediaCategory
  url      String
  caption  String?

  sortOrder  Int     @default(0)
  isFeatured Boolean @default(false)

  /// Set where the photograph is of one room category rather than the property.
  roomTypeId String?   @db.Uuid
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId, category])
  @@map("property_media")
}

/// An amenity a property can offer.
///
/// Portfolio-wide reference data, so it carries no `propertyId` and is listed
/// in `global-tables.ts` (CLAUDE.md section 3.2). "Wi-Fi" means the same thing
/// at all ten hotels; what differs is whether a given hotel offers it and
/// charges for it, which is `PropertyAmenityLink`.
model Amenity {
  id String @id @default(uuid()) @db.Uuid

  slug      String  @unique
  name      String
  iconName  String?
  groupName String

  properties PropertyAmenityLink[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("amenity")
}

/// Whether a property offers an amenity, and at what price.
model PropertyAmenityLink {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  amenityId String  @db.Uuid
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  scope AmenityScope @default(FREE)

  /// Integer minor units, like every other amount (section 3.4). Zero when
  /// the amenity is free, which the scope already says.
  priceMinor  Int     @default(0)
  pricingUnit String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@map("property_amenity_link")
}

/// A policy a property publishes to guests.
model PropertyPolicy {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type        PolicyType
  title       String
  content     String
  isMandatory Boolean    @default(true)

  /// Structured cancellation terms, where the policy has them. Prose alone
  /// cannot be enforced by a cancellation path; these can.
  freeCancellationHours  Int?
  retentionChargePercent Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([propertyId, type])
  @@map("property_policy")
}

/// A fee or surcharge a property adds beyond the room tariff.
model FeeAndSurcharge {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name String
  type FeeType @default(FIXED_PER_STAY)

  /// Integer minor units for a fixed fee; basis points are not used — a
  /// percentage fee carries its rate in `ratePercent` instead, so neither
  /// field has to mean two things.
  amountMinor Int      @default(0)
  ratePercent Decimal? @db.Decimal(5, 2)

  isTaxable    Boolean @default(true)
  applyToGroup Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([propertyId])
  @@map("fee_and_surcharge")
}

/// A guest's bill for one stay.
///
/// ===========================================================================
/// One folio per reservation, and **no stored balance**.
///
/// Section 3.4 is explicit: a folio balance is always derived by summing its
/// integer lines, never cached in a mutable column. There is deliberately no
/// `balanceAmount` here — the only way to know what is owed is to add up the
/// ledger, so there is no second number able to drift from it.
///
/// `reservationId` is unique: a reservation has at most one folio. Group
/// masters and split folios need more than that, and when they arrive this
/// gains a nullable `parentFolioId` rather than losing the constraint — one
/// bill per booking is the right default and the wrong thing to relax early.
/// ===========================================================================
model Folio {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  reservationId String      @unique @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  status   FolioStatus @default(OPEN)
  currency String      @db.Char(3)

  openedAt DateTime  @default(now()) @db.Timestamptz(6)
  closedAt DateTime? @db.Timestamptz(6)

  /// The operator's own folio number, where they assign one.
  ///
  /// Distinct from `id`, which is a uuid nobody reads aloud, and from the
  /// property's `folioPrefix`, which only shapes a generated string. This is
  /// the number written on a paper registration card or quoted down the phone.
  /// Unique per property so two folios cannot claim the same one, and nullable
  /// because most properties never assign it.
  customFolioId String?

  lines        FolioLine[]
  paymentLinks PaymentLink[]

  /// FO-14: at most one, issued from the folio once it is closed.
  invoice Invoice?

  @@unique([propertyId, customFolioId], name: "folio_unique_custom_id_per_property")
  @@index([propertyId, status])
  @@map("folio")
}

/// A numbered, immutable invoice raised from a closed folio (FO-14).
///
/// ===========================================================================
/// **Issued only from a CLOSED folio.** A closed folio is settled at zero and
/// refuses every posting (each folio write re-checks OPEN under its lock), so
/// the lines an invoice is built from can no longer change. Three triggers in
/// the migration make that a database fact rather than a convention: an
/// invoice row cannot be updated, no line can be added to an invoiced folio,
/// and an invoiced folio cannot be reopened.
///
/// **`document` is the snapshot.** Seller, bill-to, stay, lines and totals as
/// they were at issue. A later edit to the hotel's address or a company's
/// name does not rewrite an invoice already given to a guest. The scalar
/// totals beside it exist for listing and reporting without parsing JSON.
///
/// **Numbering** is per property and per Indian financial year (April to
/// March, from the business date), gapless: `invoice_sequence` is advanced in
/// the same transaction as the insert, so a rollback returns the number.
/// ===========================================================================
model Invoice {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  folioId String @unique @db.Uuid
  folio   Folio  @relation(fields: [folioId], references: [id], onDelete: Cascade)

  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  /// Printed number, e.g. `INV_2627-00001`.
  number     String
  /// Indian financial year, `2026-27`.
  fiscalYear String
  sequence   Int

  /// The business date it was issued on (section 3.3), not a timestamp.
  invoiceDate DateTime @db.Date
  issuedAt    DateTime @db.Timestamptz(6)
  issuedById  String?  @db.Uuid

  currency      String @db.Char(3)
  subtotalMinor Int
  taxMinor      Int
  totalMinor    Int
  /// Payments less refunds.
  paidMinor     Int

  document Json

  @@unique([propertyId, number], map: "invoice_unique_number_per_property")
  @@unique([propertyId, fiscalYear, sequence], map: "invoice_unique_sequence_per_year")
  @@index([propertyId, invoiceDate])
  @@map("invoice")
}

/// The last invoice number used, per property and financial year (FO-14).
model InvoiceSequence {
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  fiscalYear String
  lastNumber Int

  @@id([propertyId, fiscalYear])
  @@map("invoice_sequence")
}

/// One immutable line of a folio.
///
/// ===========================================================================
/// Append-only. Nothing here is ever updated or deleted.
///
/// A mistake is corrected by posting a reversing line that points at the
/// original through `reversesLineId`, which preserves the audit trail (section
/// 3.4). An `UPDATE` on this table is a bug, not an optimisation.
///
/// `amountMinor` is signed: charges positive, payments negative. That is what
/// makes the balance a plain `SUM(amountMinor)` with no per-kind branching —
/// and a branching sum is exactly where a payment eventually gets added
/// instead of subtracted.
///
/// The unique index on `(folioId, chargeDate)` for room charges is the
/// double-posting guard. Check-in posts the first night; the night audit posts
/// each subsequent night; both run the same insert. Without the constraint, a
/// re-run of either would charge a night twice and the guest would dispute a
/// bill the system insists is right.
/// ===========================================================================
model FolioLine {
  id String @id @default(uuid()) @db.Uuid

  propertyId String @db.Uuid

  folioId String @db.Uuid
  folio   Folio  @relation(fields: [folioId], references: [id], onDelete: Cascade)

  kind        FolioLineKind
  description String

  /// Integer minor units, signed. Never a float (section 3.4).
  amountMinor Int
  currency    String @db.Char(3)

  /// The business date this line belongs to, never `now()` (section 3.3).
  chargeDate DateTime @db.Date

  /// For a TAX line: the charge it was computed from.
  derivedFromLineId String?     @db.Uuid
  derivedFrom       FolioLine?  @relation("TaxDerivation", fields: [derivedFromLineId], references: [id], onDelete: SetNull)
  derivedTax        FolioLine[] @relation("TaxDerivation")

  /// A NEGATIVE tax delta, posted as an ADJUSTMENT because
  /// `folio_line_sign_matches_kind` keeps TAX lines non-negative. Tax is
  /// `kind = TAX OR isTaxAdjustment`; every folio total and tax report must
  /// read it that way. Only ever set on an ADJUSTMENT derived from another line.
  isTaxAdjustment Boolean @default(false)

  /// For a correction: the line it cancels.
  reversesLineId String?     @db.Uuid
  reverses       FolioLine?  @relation("Reversal", fields: [reversesLineId], references: [id], onDelete: SetNull)
  reversedBy     FolioLine[] @relation("Reversal")

  /// GP-07: the company-ledger entry a CITY_LEDGER transfer line created.
  companyLedgerEntry CompanyLedgerEntry?

  /// Staff member who posted it. Null for lines posted by the night audit.
  postedById String? @db.Uuid

  /// Method and reference, for a PAYMENT or REFUND line.
  paymentMethod PaymentMethod?
  remark        String?

  /// Instrument detail, for a payment taken by card.
  ///
  /// ===========================================================================
  /// The last four digits and the issuer, and deliberately nothing else.
  ///
  /// Four digits identify a card to a guest disputing a charge, which is what
  /// a report column is for. A PAN, an expiry or a CVV would put this database
  /// in scope for PCI DSS, and nothing here is built to that standard — so the
  /// schema makes storing them impossible rather than leaving it to a reviewer
  /// to notice. `@db.Char(4)` plus a digits-only CHECK is the whole guarantee.
  ///
  /// `paymentIssuer` is the bank or network as the terminal reported it, e.g.
  /// "HDFC Bank" or "RuPay". Free text because it comes from whatever the
  /// gateway hands back, not from a list this repository controls.
  /// ===========================================================================
  cardLast4     String? @db.Char(4)
  paymentIssuer String?

  /// Where the money was taken.
  ///
  /// `isExternalSource` marks a payment collected by someone other than the
  /// property — an OTA or a travel agent passing on what it already holds.
  /// `isExternalCard` marks one taken on a terminal outside this system, so
  /// it reconciles against a different settlement file. Both default false,
  /// which is a payment taken at this desk on this property's own instrument.
  isExternalSource Boolean @default(false)
  isExternalCard   Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// The client's reference for the payment intent this line records.
  ///
  /// ===========================================================================
  /// Null for every line the system raises on its own behalf.
  ///
  /// A night audit posting a room charge, check-in posting the arrival night,
  /// a tax line derived from a charge and a correction are all system-generated
  /// from an act that is already guarded somewhere else -- the room charge by
  /// `folio_line_one_room_charge_per_date`, a correction by the id of the line
  /// it corrects. None of them has a client intent to deduplicate, so none of
  /// them carries a key, and the unique index below ignores them: PostgreSQL
  /// treats NULLs as distinct in a unique index, so unlimited keyless lines
  /// coexist with no partial-index trickery.
  ///
  /// Nullable is also what makes this migration safe on a live table: every
  /// existing row is valid unchanged.
  idempotencyKey String?

  @@unique([propertyId, idempotencyKey], name: "folio_line_unique_idempotency_key")
  @@index([propertyId, folioId, chargeDate])
  @@index([propertyId, kind, chargeDate])
  /// PF-03: a relation load fetches children by the parent id alone; RLS's
  /// `bypass OR propertyId = …` filter can never become an index condition,
  /// so without this the propertyId-led indexes are walked end to end.
  @@index([folioId])
  @@map("folio_line")
}

/// Who changed what, and to what.
///
/// ===========================================================================
/// Required by section 3.4: every mutation of money, reservation state, rates
/// or restrictions writes a row here **in the same transaction as the change**.
/// Written afterwards it would be a log that disagrees with the database the
/// first time a transaction rolled back.
///
/// `before` and `after` are JSON snapshots of the fields that moved, not whole
/// rows — a whole-row snapshot makes every column change a schema change here
/// too, and buries the one field that actually moved.
///
/// Guest PII never goes in either side. Section 5 forbids logging it, and an
/// audit table is the most copied, exported and long-lived place in a system.
/// ===========================================================================
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Staff member responsible. Null for a system actor like the night audit.
  actorUserId String? @db.Uuid

  /// Machine-readable, e.g. `RESERVATION_CHECKED_IN`.
  event String

  /// What was changed: `reservation`, `folio`, `room`.
  entityType String
  entityId   String @db.Uuid

  before Json?
  after  Json?

  /// Why, where the actor supplied a reason.
  reason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId, createdAt])
  @@index([propertyId, entityType, entityId])
  /// The audit log viewer's "who did this" filter (AD-03).
  @@index([propertyId, actorUserId, createdAt])
  @@map("audit_log")
}

/// A property's payment-gateway onboarding state, and its on/off switch (FO-15).
///
/// Drives the operational alert on the property dashboard: a property stuck in
/// PENDING_KYC cannot take card payments, and the front desk needs to know
/// that before a guest tries to pay rather than after. Payment links can be
/// sent only from a property whose RAZORPAY row is ACTIVE (and only when the
/// API holds Razorpay keys).
///
/// One row per (property, provider) so a property can migrate between
/// providers without losing the old record.
model PaymentGatewayConfig {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  provider PaymentGatewayProvider
  status   PaymentGatewayStatus   @default(PENDING_KYC)

  /// Provider-side merchant identifier. Not a secret; API keys are never
  /// stored in the database (CLAUDE.md section 5) — they come from the
  /// environment at the point of use.
  merchantId String?

  /// When onboarding should have been finished, for the OVERDUE badge.
  onboardingDueDate DateTime? @db.Date
  activatedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, provider], name: "gateway_unique_provider_per_property")
  @@index([propertyId, status])
  @@map("payment_gateway_config")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Transactional outbox
 */
/**
 * --------------------------------------------------------------------------
 */

/// What an outbox row asks to be done.
///
/// Explicit, not free text: a worker dispatches on this value, and a typo in a
/// string would silently route an event to no handler at all. Phase A carries
/// exactly one type, which is a deliberate self-test and has no business
/// meaning -- real ARI event types land with the `channels` module, once the
/// provider contract is known (CLAUDE.md section 2).
enum OutboxEventType {
  /// Exercises the outbox end to end. Handled by a fake handler; touches
  /// nothing outside the outbox tables.
  OUTBOX_SELF_TEST
  /// NA-01: execute one night-audit run. Delivers the run to the worker; the
  /// run and its steps are the state, in PostgreSQL.
  NIGHT_AUDIT_RUN
  /// NA-04 step 8: a run finished. Reports and notifications hang off this.
  NIGHT_AUDIT_COMPLETED
  /// NO-04: email the guest their booking confirmation. Enqueued in the
  /// booking's own transaction, once per reservation (UNIQUE_FOREVER).
  RESERVATION_CONFIRMATION_EMAIL
}

/// How a row's `dedupeKey` constrains other rows.
///
/// ===========================================================================
/// The two classes are not interchangeable, and conflating them is a bug in
/// both directions.
///
/// **COALESCE** -- "the latest intent wins". An ARI push for
/// `(property, roomType, dateRange)` enqueued five times before the worker
/// drains it should become *one* push carrying the newest state, not five.
/// Uniqueness therefore applies only while a row is still PENDING: once it has
/// been processed, the same key may legitimately be enqueued again tomorrow.
///
/// **UNIQUE_FOREVER** -- "this must happen at most once, ever". A booking
/// confirmation email for reservation X must not be sent twice, and must not
/// become sendable again merely because the first one succeeded. Uniqueness
/// therefore ignores status and holds for the lifetime of the row.
///
/// A PENDING-only constraint is *not* permanent idempotency, which is why the
/// mode is stored per row and enforced by two different partial unique indexes
/// rather than one.
/// ===========================================================================
enum OutboxDedupeMode {
  COALESCE
  UNIQUE_FOREVER
}

/// Where an outbox row is in its lifecycle.
///
/// `IN_FLIGHT` is held under a **lease**, not a lock: see
/// `OutboxEvent.leaseExpiresAt`. A worker that dies mid-job cannot leave a row
/// stranded, because the lease expires and the row returns to PENDING.
enum OutboxStatus {
  /// Waiting for `availableAt` to pass, then publication.
  PENDING
  /// Claimed by a dispatcher or being handled. Lease-bound.
  IN_FLIGHT
  /// Handled successfully. Terminal.
  SUCCEEDED
  /// Attempts exhausted. Terminal until deliberately requeued. This is the
  /// dead-letter state CLAUDE.md section 5 requires, and it must alert.
  DEAD
}

/// A side effect recorded inside the transaction that caused it.
///
/// ===========================================================================
/// PostgreSQL is the source of truth. Redis is a delivery mechanism.
///
/// CLAUDE.md section 3.1 forbids HTTP calls, queue publishes and Redis reads
/// inside a transaction, and requires side effects to leave through an outbox
/// drained by a BullMQ worker. This table is that outbox.
///
/// Everything needed to rebuild the queue lives here. If Redis is flushed
/// entirely, the dispatcher re-publishes from these rows and nothing is lost;
/// there is deliberately **no** attempt at an atomic transaction spanning
/// PostgreSQL and Redis, because none is available. The consequence is
/// at-least-once delivery, never exactly-once -- so every handler must be safe
/// to run twice.
///
/// RETRY SCHEDULING LIVES HERE, NOT IN BULLMQ. Jobs are published with
/// `attempts: 1`, so BullMQ never retries on its own. On failure the worker
/// writes `attempts`, `availableAt` and `lastError` to this row and returns it
/// to PENDING. One scheduler, one counter, so the database and the queue
/// cannot disagree about how many times something has been tried.
///
/// PAYLOADS CARRY NO PII AND NO SECRETS. A row is a *reference* to work --
/// identifiers and a date range -- never a guest's name, email, address,
/// government ID or card data, and never a credential. The handler re-reads
/// what it needs from the database under the current tenant scope.
/// ===========================================================================
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid

  /// Tenant scope (CLAUDE.md section 3.2). Every operational row carries it,
  /// and a handler uses it to re-establish scope when it re-reads data.
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  eventType OutboxEventType

  /// Schema version of `payload`, so a worker deployed before a payload change
  /// can refuse a shape it does not understand instead of misreading it.
  /// Validated against a zod schema at enqueue *and* again at handling.
  payloadVersion Int @default(1)

  /// The event body. Identifiers and scalars only -- see the PII note above.
  payload Json

  /// Groups rows that mean the same work. Interpreted according to
  /// `dedupeMode`; see `OutboxDedupeMode`.
  dedupeKey  String
  dedupeMode OutboxDedupeMode @default(COALESCE)

  status OutboxStatus @default(PENDING)

  /// Attempts already made. Owned by this table, never by BullMQ.
  attempts    Int @default(0)
  maxAttempts Int @default(5)

  /// How many times a stale lease was reclaimed. Distinct from `attempts`: a
  /// reclaim means a worker died, which is an operational signal rather than a
  /// handler failure, and must not consume the retry budget.
  recoveries Int @default(0)

  /// Earliest moment this row may be published. Backoff writes the future here.
  availableAt DateTime @default(now()) @db.Timestamptz(6)

  /// Lease bookkeeping for IN_FLIGHT rows.
  claimedAt      DateTime? @db.Timestamptz(6)
  leaseExpiresAt DateTime? @db.Timestamptz(6)
  /// Which process holds the lease. For diagnosis only; never authorisation.
  claimedBy      String?

  /// Safe failure metadata: an error class and a truncated message, scrubbed
  /// of anything resembling a payload. Never a stack trace, never SQL, never
  /// a provider response body.
  lastError   String?   @db.VarChar(500)
  lastErrorAt DateTime? @db.Timestamptz(6)

  completedAt DateTime? @db.Timestamptz(6)

  /// When an operator alert for this dead letter was delivered (OB-06, WK-11).
  /// Null on a DEAD row means nobody has been told yet: the worker's alert
  /// monitor keeps retrying until a sink accepts it, so a dead letter cannot
  /// vanish into a log line. Meaningless on any other status.
  alertedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// The drain query: due rows, oldest first. Deliberately NOT led by
  /// `propertyId`, unlike every other composite index in this schema.
  ///
  /// CLAUDE.md section 3.2 requires tenant-led indexes on operational data and
  /// permits cross-property reads for night-audit orchestration. The dispatcher
  /// is exactly that kind of process: one system loop draining every property,
  /// which cannot lead with a tenant it does not have. Leading with
  /// `propertyId` here would make the only hot query in this table unindexed.
  @@index([status, availableAt])
  /// Lease reaping: find IN_FLIGHT rows whose lease has expired.
  @@index([status, leaseExpiresAt])
  /// Tenant-led, for the operator-facing view of a property's backlog.
  @@index([propertyId, status, createdAt])
  @@map("outbox_event")
}

/// ===========================================================================
/// Night audit (CLAUDE.md section 3.3; NA-01 .. NA-06).
///
/// A run is identified by (propertyId, businessDate) and is idempotent: the
/// unique index makes a second request for the same day return the first run,
/// and a COMPLETED run is never executed again. Each of the eight steps is a
/// row committed in its own transaction, so an interrupted run resumes from
/// its first step that is not COMPLETED.
/// ===========================================================================
enum NightAuditRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum NightAuditStepStatus {
  COMPLETED
  FAILED
}

model NightAuditRun {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// The business date this run closes. Step 7 advances the property past it.
  businessDate DateTime @db.Date

  status NightAuditRunStatus @default(PENDING)

  /// Who asked for it; null when the scheduler did.
  requestedById String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  startedAt     DateTime? @db.Timestamptz(6)
  completedAt   DateTime? @db.Timestamptz(6)
  /// The last failure, for the screen. Typed message only, never SQL.
  lastError     String?

  steps NightAuditStep[]

  @@unique([propertyId, businessDate], name: "night_audit_run_one_per_business_date")
  @@index([propertyId, createdAt])
  @@map("night_audit_run")
}

model NightAuditStep {
  id String @id @default(uuid()) @db.Uuid

  propertyId String @db.Uuid

  runId String        @db.Uuid
  run   NightAuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// 1..8, the canonical order of section 3.3.
  step       Int
  name       String
  status     NightAuditStepStatus
  /// What the step did: counts, exceptions, figures. Deterministic for a
  /// given ledger, so a re-run of a completed step is skipped, not repeated.
  outcome    Json
  startedAt  DateTime             @db.Timestamptz(6)
  finishedAt DateTime             @db.Timestamptz(6)

  @@unique([propertyId, runId, step], name: "night_audit_step_one_per_run")
  @@map("night_audit_step")
}

/// NA-06: the day's figures, frozen when the audit closed it. Append-only:
/// one row per (property, business date), never updated. A correction to a
/// closed day is an adjustment on the current business date (section 3.3).
model DailySnapshot {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  businessDate DateTime @db.Date
  runId        String   @db.Uuid

  roomsPhysical  Int
  roomsBlocked   Int
  /// physical - blocked: what could have been sold.
  roomsAvailable Int
  /// inventory_day.sold for the date.
  roomsSold      Int
  /// Occupancy in basis points (sold / available x 10000), an integer ratio.
  occupancyBp    Int

  currency            String @db.Char(3)
  /// Net room revenue posted for the date, corrections included.
  roomRevenueMinor    Int
  adrMinor            Int
  revparMinor         Int
  serviceRevenueMinor Int
  taxMinor            Int
  paymentsMinor       Int
  refundsMinor        Int

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([propertyId, businessDate], name: "daily_snapshot_one_per_business_date")
  @@map("daily_snapshot")
}

/// What a one-time account token is for (AU-08, AU-14).
enum AuthTokenPurpose {
  /// "Forgot password": set a new password, then every session is revoked.
  PASSWORD_RESET
  /// An invited person sets their first password.
  INVITATION
}

/// A single-use, expiring token emailed to a person (AU-08, AU-14).
///
/// ===========================================================================
/// Only a SHA-256 hash of the token is stored: the token itself exists in the
/// email and nowhere else, so a copy of this table cannot be used to reset
/// anybody's password. Single use is enforced by consuming it with a
/// conditional update (`consumedAt IS NULL AND expiresAt > now()`), so two
/// concurrent submissions of one link cannot both succeed.
///
/// Portfolio-global, like `User` and `TwoFactorChallenge`: it belongs to an
/// identity, and the reset flow runs before any property is resolved.
/// ===========================================================================
model AuthToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   AuthTokenPurpose
  /// SHA-256 of the emailed token, hex.
  tokenHash String           @unique

  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  /// Superseded by a newer token of the same purpose, or by deactivation.
  revokedAt  DateTime? @db.Timestamptz(6)

  /// Who sent an invitation; null for a self-service reset.
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, purpose])
  @@map("auth_token")
}

/// ===========================================================================
/// Housekeeping (HK-01 .. HK-04).
///
/// A task is one piece of work on one room: clean it, deep-clean it, turn it
/// down, or inspect it. At most one active (OPEN or IN_PROGRESS) task per room
/// and type -- a partial unique index, so two supervisors cannot both queue
/// the same cleaning. Completion is tracked (who, when), and completing a
/// cleaning or recording an inspection changes the room's status in the same
/// transaction, audited, through the same transition rules as the status
/// endpoint.
/// ===========================================================================
enum HousekeepingTaskType {
  CLEAN
  DEEP_CLEAN
  TURNDOWN
  INSPECTION
}

enum HousekeepingTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum InspectionResult {
  PASSED
  FAILED
}

model HousekeepingTask {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomId String @db.Uuid
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  type   HousekeepingTaskType
  status HousekeepingTaskStatus @default(OPEN)

  /// Who it is assigned to; null while unassigned.
  assignedToId String? @db.Uuid
  notes        String?

  /// The business date the task was raised on (section 3.3), not now().
  businessDate DateTime @db.Date

  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  startedAt     DateTime? @db.Timestamptz(6)
  completedAt   DateTime? @db.Timestamptz(6)
  completedById String?   @db.Uuid
  cancelledAt   DateTime? @db.Timestamptz(6)

  /// Set on an INSPECTION task when it is recorded.
  inspectionResult InspectionResult?

  @@index([propertyId, status])
  @@index([propertyId, roomId])
  @@index([propertyId, assignedToId, status])
  @@map("housekeeping_task")
}

/// A reusable guest profile (GP-02).
///
/// ===========================================================================
/// One per guest per property. Shared across the portfolio it would be a
/// cross-tenant record (section 3.2), so a guest who stays at two hotels has
/// two profiles, as they have two companies' worth of terms with `Company`.
///
/// `emailNormalized` and `phoneNormalized` are the matching keys, written by
/// the service from the same helpers that match `reservation_guest` rows.
/// They are deliberately NOT unique: a family shares a phone and an agent's
/// email is on many bookings. Duplicates are suggested, never merged.
///
/// Guest PII. Never logged, never copied into `audit_log` (section 5).
/// ===========================================================================
model GuestProfile {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String  @default("")
  email       String?
  phone       String?
  countryCode String? @db.Char(2)

  emailNormalized String?
  phoneNormalized String?

  preferences String?
  notes       String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  stays ReservationGuest[]

  @@index([propertyId, lastName, firstName])
  @@index([propertyId, emailNormalized])
  @@index([propertyId, phoneNormalized])
  @@map("guest_profile")
}

enum CompanyLedgerEntryKind {
  /// A folio balance billed to the company. Positive.
  TRANSFER
  /// The company paid against its account. Negative.
  PAYMENT
}

/// The city ledger: what each company owes this property (GP-07).
///
/// ===========================================================================
/// Append-only, like `folio_line`: an UPDATE is refused by a trigger, and a
/// mistake is corrected by a new entry. A company's balance is the sum of its
/// entries and is never stored (section 3.4).
///
/// A TRANSFER is written in the same transaction as the guest folio's
/// CITY_LEDGER payment line it mirrors, and points at it (`folioLineId`,
/// unique), so the two cannot disagree. CHECK constraints in the migration
/// pin the sign and the required fields to the kind.
/// ===========================================================================
model CompanyLedgerEntry {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction)

  kind CompanyLedgerEntryKind

  /// Integer minor units, signed by kind.
  amountMinor Int
  currency    String @db.Char(3)

  /// The business date it was posted on (section 3.3), never `now()`.
  postingDate DateTime @db.Date

  /// TRANSFER only: the stay and the folio line it came from.
  reservationId String?      @db.Uuid
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  folioLineId   String?      @unique @db.Uuid
  folioLine     FolioLine?   @relation(fields: [folioLineId], references: [id], onDelete: Cascade)

  /// PAYMENT only: how the company paid, and its reference.
  paymentMethod PaymentMethod?
  reference     String?

  remark         String?
  postedById     String? @db.Uuid
  /// PAYMENT only; a TRANSFER is deduplicated by its folio line's key.
  idempotencyKey String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([propertyId, idempotencyKey], name: "company_ledger_unique_idempotency_key")
  @@index([propertyId, companyId, postingDate])
  @@map("company_ledger_entry")
}

enum PaymentLinkStatus {
  /// Row written; the provider has not confirmed the link yet.
  CREATING
  /// Live at the provider and payable.
  ACTIVE
  PARTIALLY_PAID
  PAID
  CANCELLED
  EXPIRED
  /// The provider refused or could not be reached when creating it.
  FAILED
  /// Money was captured but could not be posted (e.g. the folio had closed).
  /// A person must post it by hand or refund it at the provider.
  NEEDS_ATTENTION
}

/// A hosted payment link sent to a guest for a folio balance (FO-15).
///
/// ===========================================================================
/// The link is ours first: this row is written before the provider is called,
/// and its id is the provider's `reference_id` (unique at Razorpay), so a
/// retried creation cannot open a second link. The provider is called outside
/// any transaction (section 3.1).
///
/// The row is NOT the money. A captured payment is posted to the folio as an
/// ordinary PAYMENT line whose idempotency key is `razorpay_<payment id>`, so
/// a webhook and a status check racing on one payment post it once. This row
/// only tracks the link's lifecycle for the screens.
///
/// No guest PII is stored here: the provider holds the contact it was sent to.
/// ===========================================================================
model PaymentLink {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  folioId       String      @db.Uuid
  folio         Folio       @relation(fields: [folioId], references: [id], onDelete: Cascade)
  reservationId String      @db.Uuid
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  provider       PaymentGatewayProvider
  /// The provider's id, e.g. `plink_...`. Null until the provider confirms.
  providerLinkId String?
  shortUrl       String?

  amountMinor     Int
  amountPaidMinor Int    @default(0)
  currency        String @db.Char(3)

  status    PaymentLinkStatus @default(CREATING)
  /// The provider's or the poster's last error, short, never a payload.
  lastError String?

  expiresAt DateTime @db.Timestamptz(6)

  /// The client's key for "send this link", so a retried click is one link.
  idempotencyKey String

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, idempotencyKey], name: "payment_link_unique_idempotency_key")
  @@unique([propertyId, provider, providerLinkId], name: "payment_link_unique_provider_link")
  @@index([propertyId, createdAt])
  @@index([propertyId, folioId])
  @@map("payment_link")
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

/// A maintenance work order on one room (MA-01).
///
/// ===========================================================================
/// A fault report with a lifecycle (OPEN, IN_PROGRESS, then RESOLVED or
/// CANCELLED). It may take the room out of order: that is a `room_block`
/// (reason MAINTENANCE) created in the SAME transaction as the order and
/// linked here, so inventory follows through the block code's own counter
/// rules (`inventory_day.blocked`, the oversell CHECK, the refusal to block a
/// room holding a stay). Resolving or cancelling gives the room back from the
/// business date: the nights it really was out of order stay blocked, so
/// occupancy history is not rewritten.
///
/// Lock order on every write: work order row, then block row, then inventory.
/// ===========================================================================
model WorkOrder {
  id String @id @default(uuid()) @db.Uuid

  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomId String @db.Uuid
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  title       String
  description String?
  priority    WorkOrderPriority @default(NORMAL)
  status      WorkOrderStatus   @default(OPEN)

  reportedById String  @db.Uuid
  assignedToId String? @db.Uuid

  /// The block that holds the room out of order, while one does.
  roomBlockId String?    @db.Uuid
  roomBlock   RoomBlock? @relation(fields: [roomBlockId], references: [id], onDelete: SetNull)

  resolutionNote String?
  closedById     String?   @db.Uuid
  closedAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([propertyId, roomBlockId], name: "work_order_unique_block")
  @@index([propertyId, status, createdAt])
  @@index([propertyId, roomId, status])
  @@map("work_order")
}
