# EaseIt server settings (CI-14). Copy to deploy/.env on the server and fill
# in. That file holds secrets: chmod 600, never commit it.

# Which images to run.
EASEIT_REGISTRY=ghcr.io/your-org
EASEIT_VERSION=1.0.0

# Public hostnames (DNS must point at this server). The web images are built
# for these exact URLs; see the release workflow's repository variables.
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
BOOKING_DOMAIN=book.example.com
MARKETING_DOMAIN=www.example.com
ACME_EMAIL=ops@example.com

# The session cookie is shared by api.* and admin.*, so it is set on their
# common parent domain, with the leading dot.
AUTH_COOKIE_DOMAIN=.example.com

# PostgreSQL. The owner login is used only by the `migrate` step; the API and
# worker use APP_DB_ROLE. Generate each with: openssl rand -hex 24
POSTGRES_USER=easeit
POSTGRES_DB=easeit
POSTGRES_PASSWORD=
APP_DB_ROLE=easeit_app
APP_DB_PASSWORD=

# Session signing key. Generate with: openssl rand -hex 32
JWT_SECRET=

# Mail: sign-in codes, invitations, password resets and booking
# confirmations are all emailed, so this must work before anyone can sign in.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EaseIt <no-reply@example.com>

# GSTIN lookups. Required: the API will not start in production with mock
# data, because an invented legal name would end up on a tax invoice.
# sandbox (api.sandbox.co.in) or cashfree; the key from that provider.
GST_PROVIDER=
GST_API_KEY=

# API documentation at /api/docs. Leave off in production.
SWAGGER_ENABLED=false
