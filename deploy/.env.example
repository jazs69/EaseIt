# EaseIt server settings (CI-14). Copy to deploy/.env on the server and fill
# in. That file holds secrets: chmod 600, never commit it.

# Which images to run.
EASEIT_REGISTRY=ghcr.io/your-org
EASEIT_VERSION=1.0.0

# Public hostnames (DNS must point at this server). The web images are built
# for these exact URLs; see the release workflow's repository variables.
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
BOOKING_DOMAIN=book.example.com
MARKETING_DOMAIN=www.example.com
ACME_EMAIL=ops@example.com

# The session cookie is shared by api.* and admin.*, so it is set on their
# common parent domain, with the leading dot.
AUTH_COOKIE_DOMAIN=.example.com

# PostgreSQL. The owner login is used only by the `migrate` step; the API and
# worker use APP_DB_ROLE. Generate each with: openssl rand -hex 24
POSTGRES_USER=easeit
POSTGRES_DB=easeit
POSTGRES_PASSWORD=
APP_DB_ROLE=easeit_app
APP_DB_PASSWORD=

# Session signing key. Generate with: openssl rand -hex 32
JWT_SECRET=

# Mail: sign-in codes, invitations, password resets and booking
# confirmations are all emailed, so this must work before anyone can sign in.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EaseIt <no-reply@example.com>

# GSTIN lookups. Required: the API will not start in production with mock
# data, because an invented legal name would end up on a tax invoice.
# sandbox (api.sandbox.co.in) or cashfree, with that provider's LIVE key and
# secret (Sandbox: API key + secret; Cashfree: client id + client secret).
# GST_ENVIRONMENT must be live in production: a provider's test host answers
# with canned taxpayers. Check the keys first with `pnpm gst:smoke` (deploy/README.md).
GST_PROVIDER=
GST_API_KEY=
GST_API_SECRET=
GST_ENVIRONMENT=live

# Alerts. A background job that fails for good (a booking confirmation email,
# a night-audit step) or a worker that has stopped picking work up is reported
# here. Required: comma-separated addresses, sent through the SMTP settings
# above. Optional: an incoming webhook (Slack, Teams, any HTTPS receiver)
# that gets the same alert as JSON.
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=

# Prometheus scrape token for GET /api/v1/metrics (required). Generate with
# `openssl rand -hex 32`; give the same value to your Prometheus scrape job
# as `authorization: { credentials: <token> }`.
METRICS_TOKEN=

# Razorpay payment links (optional). Live keys from the Razorpay dashboard
# (rzp_live_...), and the webhook secret you set there for the URL
# https://<api host>/api/v1/webhooks/razorpay with the payment_link.* events.
# Then switch payments on per property on its Payments screen.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Backups (deploy/backup.sh). One dump a day at BACKUP_TIME, in UTC
# (20:30 UTC is 02:00 in India, after the night audit), restored into a
# scratch database and checked before it counts. Kept BACKUP_RETENTION_DAYS
# days; the newest BACKUP_MIN_KEEP verified ones are never deleted.
# BACKUP_DIR is on this server: copy it to another machine as well (README).
BACKUP_TIME=20:30
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_KEEP=3
BACKUP_DIR=/opt/easeit/backups

# API documentation at /api/docs. Leave off in production.
SWAGGER_ENABLED=false
