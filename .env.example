# ---------------------------------------------------------------------------
# Copy to .env (root) and packages/database/.env, then fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL — pooled connection used by the app at runtime
DATABASE_URL="postgresql://easeit:easeit@localhost:5432/easeit?schema=public"
# Direct (unpooled) connection — required by Prisma Migrate
DIRECT_URL="postgresql://easeit:easeit@localhost:5432/easeit?schema=public"

# Redis — BullMQ queues + short-TTL availability cache
REDIS_URL="redis://localhost:6379"

# API
PORT=4000
NODE_ENV=development
API_CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
# Signs session tokens; a labelled derivation also peppers the stored
# two-factor code hashes. Rotating it logs everybody out.
JWT_SECRET="replace-me-with-at-least-32-characters-of-random-entropy"
JWT_EXPIRES_IN="8h"
SWAGGER_ENABLED=true

# Session cookie. Leave the domain unset in development; in production set the
# registrable domain so the API and admin subdomains share one cookie.
AUTH_COOKIE_NAME="easeit_session"
# AUTH_COOKIE_DOMAIN=".yourdomain.com"

# Outbound mail. Unset SMTP_HOST in development prints two-factor codes to the
# API console instead of emailing them; it is REQUIRED in production, where the
# API refuses to boot without a transport. See apps/api/.env.example.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM='"EaseIt Security" <you@gmail.com>'

# Web apps
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_BOOKING_URL="http://localhost:3002"
