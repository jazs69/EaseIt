# ---------------------------------------------------------------------------
# Copy to .env (root) and packages/database/.env, then fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL — pooled connection used by the app at runtime
DATABASE_URL="postgresql://easeit:easeit@localhost:5432/easeit?schema=public"
# Direct (unpooled) connection — required by Prisma Migrate
DIRECT_URL="postgresql://easeit:easeit@localhost:5432/easeit?schema=public"

# Redis — BullMQ queues + short-TTL availability cache
REDIS_URL="redis://localhost:6379"

# API
PORT=4000
NODE_ENV=development
API_CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
JWT_SECRET="replace-me-with-at-least-32-characters-of-random-entropy"
JWT_EXPIRES_IN="8h"
SWAGGER_ENABLED=true

# Web apps
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_BOOKING_URL="http://localhost:3002"
