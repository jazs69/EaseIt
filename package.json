{
  "name": "easeit",
  "version": "0.1.0",
  "private": true,
  "description": "EaseIt \u2014 multi-tenant Hotel PMS, Channel Manager and Direct Booking Engine",
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "worker:dev": "pnpm --filter @repo/api worker:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,css}\" --ignore-path .gitignore",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:seed": "turbo run db:seed",
    "db:studio": "turbo run db:studio",
    "db:reset": "turbo run db:reset",
    "test:concurrency": "node test/concurrency/parallel-booking.test.mjs",
    "test:outbox": "node test/integration/outbox.test.mjs",
    "test:outbox:concurrency": "node test/concurrency/outbox-claim.test.mjs",
    "test:outbox:redis": "node test/integration/outbox-redis.test.mjs",
    "test:checkin": "node test/integration/check-in.test.mjs",
    "test:cancellation": "node test/integration/cancel-reservation.test.mjs"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.8",
    "typescript": "6.0.3"
  }
}
